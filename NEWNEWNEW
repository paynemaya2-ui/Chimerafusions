            ("Inter-gene fusions",     str(n_fus)),
            ("SVG diagrams generated", str(n_with_svg)),
            ("Report generated",       run_date),
        ]
    ])

    # ── 6. Gene lookup index (for JS search) ─────────────────────────────────
    gene_index_js = {}
    for idx, (_, row) in enumerate(summary.iterrows()):
        for g in [str(row["geneA"]), str(row["geneB"])]:
            gene_index_js.setdefault(g.upper(), []).append(f"card_{idx}")
    gene_index_json = _json.dumps(gene_index_js)

    # ── 7. ACMG breakdown bars for each card (pre-computed) ───────────────────
    # Already built inline per card below — inject into card HTML
    # Re-build cards with breakdown bars added
    # Find the meta-panel in each card and add the bar after ACMG codes row
    cards_with_bars = []
    for idx, (_, row) in enumerate(summary.iterrows()):
        gene_a   = _html.escape(str(row["geneA"]))
        gene_b   = _html.escape(str(row["geneB"]))
        path     = str(row.get("pathogenicity", "Uncertain_Significance"))
        pc       = path_colors.get(path, "#7f8c8d")
        path_lbl = path.replace("_", " ")
        acmg_sc  = str(row.get("acmg_score", ""))
        acmg_codes_str = str(row.get("acmg_codes", "."))
        frame    = str(row.get("reading_frame", "UNKNOWN"))
        fc       = frame_colors.get(frame, "#7f8c8d")
        frame_lbl = frame.replace("_", " ").title()
        mech     = _html.escape(str(row.get("mechanism","")).replace("_FUSION","").replace("_"," "))
        svtypes  = _html.escape(str(row.get("svtypes","")))
        fclass   = _html.escape(str(row.get("fusion_class","")))
        support  = _html.escape(str(row.get("support_score","")))
        evidence = _html.escape(str(row.get("pathogenicity_evidence","")))
        var_ids  = _html.escape(str(row.get("variant_ids",""))[:60])
        strand_a = _html.escape(str(row.get("strandA",".")))
        strand_b = _html.escape(str(row.get("strandB",".")))
        recip    = str(row.get("reciprocal_pair_id",""))
        recip_row = (f'<tr><th>Reciprocal pair</th>'
                     f'<td colspan="3" class="recip">{_html.escape(recip)}</td></tr>'
                     if recip else "")
        try:
            score_f = float(acmg_sc)
            score_col = ("#c0392b" if score_f>=6 else "#e67e22" if score_f>=0
                         else "#27ae60" if score_f<=-6 else "#7f8c8d")
        except ValueError:
            score_col = "#7f8c8d"

        svg_name = f"{slug(row['geneA'])}_{slug(row['geneB'])}_fusion.svg"
        svg_path_check = svg_dir / svg_name
        svg_inline = ""
        if svg_path_check.exists():
            raw = svg_path_check.read_text(encoding="utf-8")
            raw = re.sub(r'<\?xml[^?]*\?>\s*', '', raw)
