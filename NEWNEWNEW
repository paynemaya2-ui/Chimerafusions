        )
    gene_table = "".join(gene_rows)

    mean_score = int(sum(s["acmg_scores"]) / len(s["acmg_scores"])) if s["acmg_scores"] else 0

    callout_html = (
        f'<div class="callout alert">&#9888; {n_path} Pathogenic/Likely Pathogenic '
        f'inter-gene fusion(s) detected. Review the Priority Fusions table below.</div>'
        if n_path > 0
        else '<div class="callout">No Pathogenic or Likely Pathogenic inter-gene '
             'fusions detected in this cohort.</div>'
    )

    source_esc = _html.escape(str(source_label))

