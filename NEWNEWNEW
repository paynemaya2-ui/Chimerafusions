    # ── Build cohort summary section using report helpers ─────────────────────
    df_rpt = summary.copy()
    df_rpt["acmg_score"]    = pd.to_numeric(df_rpt["acmg_score"],    errors="coerce").fillna(0)
    df_rpt["support_score"] = pd.to_numeric(df_rpt["support_score"], errors="coerce").fillna(0)
    s = _rpt_compute_stats(df_rpt)

    def pct(n, d):
        return f"{n / d * 100:.1f}%" if d else "0%"

    n_path   = s["path_all"].get("Pathogenic", 0) + s["path_all"].get("Likely_Pathogenic", 0)
    n_vus    = s["path_all"].get("Uncertain_Significance", 0)
    n_benign = s["path_all"].get("Likely_Benign", 0) + s["path_all"].get("Benign", 0)
    n_canon  = s["fclass"].get("CANONICAL", 0) + s["fclass"].get("HIGH_CONF_CANONICAL", 0)
    n_inframe= s["frame_inter"].get("IN_FRAME", 0)
    mean_score = int(sum(s["acmg_scores"]) / len(s["acmg_scores"])) if s["acmg_scores"] else 0

    pie_path       = _rpt_svg_pie({k: s["path_all"].get(k, 0) for k in _REPORT_PATH_ORDER}, _REPORT_PATH_COLORS)
    pie_path_inter = _rpt_svg_pie({k: s["path_inter"].get(k, 0) for k in _REPORT_PATH_ORDER}, _REPORT_PATH_COLORS)
    pie_frame      = _rpt_svg_pie(dict(s["frame_inter"]), _REPORT_FRAME_COLORS)
    bar_mech       = _rpt_svg_bar_h(dict(s["mech_inter"]), _REPORT_MECH_COLORS)
    sv_colors      = {"DEL": "#2980b9", "DUP": "#e67e22", "INV": "#16a085", "BND": "#8e44ad"}
    bar_sv         = _rpt_svg_bar_h(dict(s["sv_types"]), sv_colors, width=280)
