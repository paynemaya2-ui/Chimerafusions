def load_cancer_genes(cosmic_file):
    """
    Load the COSMIC Cancer Gene Census (CGC) TSV/CSV.

    Returns two sets of uppercased gene symbols:
        oncogenes   — genes where gain-of-function drives cancer
        tsgs        — tumour suppressor genes (loss-of-function)

    A gene can appear in both sets (e.g. TP53 has TSG and occasionally
    dominant-negative roles; some entries are ambiguous).

    The CGC file can be obtained from:
        https://cancer.sanger.ac.uk/census  (requires free registration)
    Expected columns (TSV or CSV):
        Gene Symbol, Role in Cancer
    "Role in Cancer" values include combinations of:
        "oncogene", "TSG", "fusion"  (comma/space-separated within the cell)

    If the file is absent or unreadable both sets are returned empty and
    the caller proceeds without cancer-gene evidence.
    """
    oncogenes: set = set()
    tsgs:      set = set()

    p = Path(cosmic_file)
    if not p.exists():
        return oncogenes, tsgs

    try:
        import io
        text = p.read_bytes().decode("utf-8-sig", errors="replace")
        sep  = "," if text.splitlines()[0].count(",") > text.splitlines()[0].count("\t") else "\t"
        df   = pd.read_csv(io.StringIO(text), sep=sep, dtype=str,
                           low_memory=False, skip_blank_lines=True)
        df.columns = [c.strip().lower().replace(" ", "_") for c in df.columns]

        gene_col = next(
            (c for c in df.columns if "gene" in c and "symbol" in c),
            next((c for c in df.columns if c in {"gene_symbol", "symbol", "gene"}), None),
        )
        role_col = next(
            (c for c in df.columns if "role" in c and "cancer" in c),
            next((c for c in df.columns if "role" in c), None),
        )
        if gene_col is None or role_col is None:
            print(f"Warning: COSMIC file columns not recognised — "
                  f"cancer-gene evidence disabled. Columns: {list(df.columns)}")
            return oncogenes, tsgs

        for _, row in df.iterrows():
            gene = str(row.get(gene_col, "")).strip().upper()
            role = str(row.get(role_col, "")).strip().lower()
            if not gene or gene in {"NAN", "NONE", ""}:
                continue
            if "oncogene" in role:
                oncogenes.add(gene)
            if "tsg" in role or "tumour suppressor" in role or "tumor suppressor" in role:
                tsgs.add(gene)

        print(f"COSMIC cancer genes loaded: {len(oncogenes)} oncogenes, "
              f"{len(tsgs)} tumour suppressors")
    except Exception as exc:
        print(f"Warning: COSMIC file could not be loaded ({exc}) — "
              f"cancer-gene evidence disabled")

    return oncogenes, tsgs


def load_clingen_dosage(clingen_file):
    import io
    p = Path(clingen_file)
    if not p.exists():
        raise FileNotFoundError(f"ClinGen dosage file not found: {clingen_file}")

    text       = p.read_bytes().decode("utf-8-sig", errors="replace")
    first_line = text.splitlines()[0] if text.strip() else ""
    sep        = "," if first_line.count(",") > first_line.count("\t") else "\t"

    df = pd.read_csv(
        io.StringIO(text), sep=sep, low_memory=False, dtype=str,
        comment=None, skip_blank_lines=True,
    )
    df.columns = [str(c).strip().lower().replace(" ", "_") for c in df.columns]

    gene_col = next(
        (c for c in df.columns if "gene" in c and ("symbol" in c or "name" in c)),
        next((c for c in df.columns if "gene" in c), None),
    )
    hi_col = next(
        (c for c in df.columns if "haploinsuf" in c and "score" in c),
        next((c for c in df.columns if c in {"hi_score", "hi score"}), None),
    )
    ts_col = next(
        (c for c in df.columns if "triplosensi" in c and "score" in c),
        next((c for c in df.columns if c in {"ts_score", "ts score"}), None),
    )
    if gene_col is None:
        raise ValueError(
            f"Cannot find gene symbol column in ClinGen file. "
            f"Available columns: {list(df.columns)}"
        )
    if "type" in df.columns:
        df = df[df["type"].str.strip().str.lower() == "gene"]

    def _parse_score(val):
        s = str(val).strip().lower().replace(" ", "")
        label_map = {
            "sufficientevidence": 3, "emergingevidence": 2,
            "littleevidence": 1,     "sensitivityunlikely": 40,
            "noevidence": 0,         "autosomalrecessive": 30,
        }
        if s in label_map:
            return label_map[s]
        try:
            v = int(float(s))
            return v if v in {0, 1, 2, 3, 30, 40} else -1
        except (ValueError, TypeError):
            return -1

    _hgnc_strip = re.compile(r"HGNC:\d+$", re.IGNORECASE)
    hi_genes, ts_genes = {}, {}
    for _, row in df.iterrows():
        gene = str(row.get(gene_col, "")).strip()
        gene = _hgnc_strip.sub("", gene).strip().upper()
        if not gene or gene in {"NAN", "NONE", ".", ""}:
            continue
        if hi_col:
            hi = _parse_score(row.get(hi_col, ""))
            if hi >= 0:
                hi_genes[gene] = hi
        if ts_col:
            ts = _parse_score(row.get(ts_col, ""))
            if ts >= 0:
                ts_genes[gene] = ts
    return hi_genes, ts_genes


_CLINGEN_PATH      = {3, 2}
_CLINGEN_WEAK_PATH = {1}        # Fix 3: little evidence — weak positive signal
_CLINGEN_BENIGN    = {40, 0}
_CLINGEN_AR        = {30}       # Fix 4: autosomal recessive only

_W = {
    "PVS1":            8,
    "PM_INFRAME":      2,
    "PS1":             6,
    "PM1":             2,
    "PM_INFRAME_NOHI": 4,
    "PM_ONCOGENE":     2,   # Fix 8: known oncogene, canonical
    "PP3":             1,
    "PP_WEAK_HI":      1,   # Fix 3: HI=1 weak signal
    "BP_OOF":         -2,   # Fix 2: confirmed out-of-frame
    "BP4":            -1,
    "BP7":            -1,
    "BP_AR":          -1,   # Fix 4: AR-only gene
    "BS1":            -4,
    "BS_TSG_OOF":     -2,   # Fix 8: TSG + OOF
}

_PATH_THRESHOLDS = [
    (10, "Pathogenic"),
    (6,  "Likely_Pathogenic"),
    (-5, "Uncertain_Significance"),
    (-9, "Likely_Benign"),
]


def classify_pathogenicity(gene_a, gene_b, fusion_class, reading_frame,
                            mechanism, hi_genes, ts_genes,
                            oncogenes=None, tsgs=None,
                            sex_chrom_context=False):
    """
    Returns (call, acmg_codes, path_evidence, raw_score).

    sex_chrom_context: True when either breakpoint falls on chrX or chrY.
    When True an informational note is appended to path_evidence — it does
    not change the ACMG score since hemizygosity penetrance depends on
    patient sex which the pipeline does not know, but reviewers should be
    aware that X-linked fusions in males are hemizygous.
    """
    codes, details = [], []
    score = 0

    ga = gene_a.upper()
    gb = gene_b.upper()

    _onco = oncogenes or set()
    _tsg  = tsgs      or set()

    is_canonical = (
        "CANONICAL" in str(fusion_class)
        and "NON_CANONICAL" not in str(fusion_class)
    )
    is_in_frame  = reading_frame == "IN_FRAME"
    is_oof       = reading_frame == "OUT_OF_FRAME"
    frame_known  = reading_frame in {"IN_FRAME", "OUT_OF_FRAME"}
    same_gene    = (ga == gb)
    is_dup       = "DUPLICATION" in str(mechanism).upper()

    hi_a = hi_genes.get(ga, -1)
    hi_b = hi_genes.get(gb, -1)
    ts_a = ts_genes.get(ga, -1)
    ts_b = ts_genes.get(gb, -1)

    both_hi    = hi_a in _CLINGEN_PATH and hi_b in _CLINGEN_PATH
    one_hi     = (hi_a in _CLINGEN_PATH) != (hi_b in _CLINGEN_PATH)
    no_hi_data = hi_a < 0 and hi_b < 0
    weak_hi    = hi_a in _CLINGEN_WEAK_PATH or hi_b in _CLINGEN_WEAK_PATH
    ar_gene    = hi_a in _CLINGEN_AR or hi_b in _CLINGEN_AR
    onco_hit   = ga in _onco or gb in _onco
    tsg_hit    = ga in _tsg  or gb in _tsg

    # ── Benign criteria ───────────────────────────────────────────────────────
    if same_gene:
        codes.append("BP7")
        details.append("intragenic — same gene on both sides")
        score += _W["BP7"]

    if hi_a in _CLINGEN_BENIGN and hi_b in _CLINGEN_BENIGN:
        codes.append("BP4")
        details.append(f"both genes dosage-insensitive (HI: {hi_a}, {hi_b})")
        score += _W["BP4"]

    if ar_gene:                                          # Fix 4
        ar_which = ga if hi_a in _CLINGEN_AR else gb
        codes.append("BP_AR")
        details.append(f"{ar_which} autosomal recessive only (HI 30)")
        score += _W["BP_AR"]

    if is_oof:                                           # Fix 2
        codes.append("BP_OOF")
        details.append("confirmed out-of-frame junction")
        score += _W["BP_OOF"]

    if (is_dup and ts_a >= 0 and ts_b >= 0
            and ts_a not in _CLINGEN_PATH and ts_b not in _CLINGEN_PATH):
        codes.append("BS1")
        details.append(
            f"duplication; neither gene triplosensitive (TS: {ts_a}, {ts_b})"
        )
        score += _W["BS1"]

    if tsg_hit and is_oof:                               # Fix 8
        tsg_which = ga if ga in _tsg else gb
        codes.append("BS_TSG_OOF")
        details.append(
            f"{tsg_which} tumour suppressor; out-of-frame fusion unlikely productive"
        )
        score += _W["BS_TSG_OOF"]

    # ── Non-canonical penalty  (Fix 5) ───────────────────────────────────────
    if not is_canonical:
        score -= 3
        details.append("non-canonical junction (−3 penalty)")

    # ── Pathogenic criteria ───────────────────────────────────────────────────
    if both_hi and is_canonical and is_in_frame:
        codes.append("PVS1")
        details.append(
            f"both genes haploinsufficient (HI: {hi_a}, {hi_b}); canonical; in-frame"
        )
        score += _W["PVS1"]
        codes.append("PM_INFRAME")
        details.append("in-frame junction confirmed")
        score += _W["PM_INFRAME"]

    elif both_hi and is_canonical:
        codes.append("PS1")
        details.append(
            f"both genes haploinsufficient (HI: {hi_a}, {hi_b}); canonical"
        )
        score += _W["PS1"]

    else:
        if one_hi and is_canonical:
            which = ga if hi_a in _CLINGEN_PATH else gb
            hi_v  = hi_a if hi_a in _CLINGEN_PATH else hi_b
            codes.append("PM1")
            details.append(f"{which} haploinsufficient (HI {hi_v}); canonical")
            score += _W["PM1"]

        if is_canonical and is_in_frame and not no_hi_data:
            codes.append("PM_INFRAME")
            details.append("in-frame junction confirmed")
            score += _W["PM_INFRAME"]
        elif is_canonical and is_in_frame and no_hi_data:
            codes.append("PM_INFRAME_NOHI")
            details.append("canonical + in-frame; no ClinGen dosage data")
            score += _W["PM_INFRAME_NOHI"]
        elif is_canonical and not frame_known:
            codes.append("PP3")
            details.append("canonical; reading frame undetermined")
            score += _W["PP3"]

    if weak_hi and is_canonical:                         # Fix 3
        weak_which = ", ".join(
            g for g, h in [(ga, hi_a), (gb, hi_b)] if h in _CLINGEN_WEAK_PATH
        )
        codes.append("PP_WEAK_HI")
        details.append(f"{weak_which} little HI evidence (HI score 1)")
        score += _W["PP_WEAK_HI"]

    if onco_hit and is_canonical:                        # Fix 8
        onco_which = ", ".join(g for g in [ga, gb] if g in _onco)
        codes.append("PM_ONCOGENE")
        details.append(f"{onco_which} known oncogene; canonical fusion")
        score += _W["PM_ONCOGENE"]

    if not codes:
        details.append("no evidence criteria met")

    # Fix 5: sex chromosome context note
    if sex_chrom_context:
        details.append(
            "NOTE: breakpoint(s) on sex chromosome — in hemizygous males "
            "X-linked fusions may have higher effective penetrance"
        )

    call = _path_call(score)
    return call, ";".join(codes) if codes else ".", " | ".join(details), score


def display_pathogenicity(call):
    mapping = {
        "Pathogenic":             ("PATHOGENIC",             "#7B0000"),
        "Likely_Pathogenic":      ("LIKELY PATHOGENIC",      "#c0392b"),
        "Uncertain_Significance": ("UNCERTAIN SIGNIFICANCE", "#7f8c8d"),
        "Likely_Benign":          ("LIKELY BENIGN",          "#1a6b3a"),
        "Benign":                 ("BENIGN",                 "#145a32"),
    }
    return mapping.get(call, ("UNCERTAIN SIGNIFICANCE", "#7f8c8d"))


def build_summary(edge_counts, edge_svtypes, edge_events, exon_index,
                  hi_genes=None, ts_genes=None, oncogenes=None, tsgs=None,
                  min_support_score=0.0, debug_genes=None):
    out = []
    for (gene_a, gene_b), count in edge_counts.items():
        unique_sv      = sorted(set(edge_svtypes[(gene_a, gene_b)]))
        mechanism      = classify_mechanism(unique_sv)
        events         = edge_events[(gene_a, gene_b)]
        variant_ids    = sorted({event["variant_id"] for event in events})
        variant_types  = sorted({event["variant_type"] for event in events})
        variant_type   = most_common([event["variant_type"] for event in events])

        # Fix 2: track whether orientation data is actually present in input.
        # When all breakpoint orientations are "." the column is meaningless.
        raw_orient_a   = most_common([event["break1_orientation"] for event in events]) or "."
        raw_orient_b   = most_common([event["break2_orientation"] for event in events]) or "."
        orientations_available = raw_orient_a in {"+", "-"} and raw_orient_b in {"+", "-"}
        orientation_a  = raw_orient_a if orientations_available else "."
        orientation_b  = raw_orient_b if orientations_available else "."
        orient_rel     = orientation_relation(orientation_a, orientation_b) if orientations_available else "not_provided"

        strand_a       = most_common([event["strandA"] for event in events])
        strand_b       = most_common([event["strandB"] for event in events])
        relation       = most_common([event["strand_relation"] for event in events])
        support_score  = round(0.5 * count + 0.5 * len(unique_sv), 2)

        label, classification_reason, promoter_bp = predict_fusion_class(
            gene_a, gene_b, variant_type, strand_a, strand_b, count
        )

        reading_frame = consensus_reading_frame(exon_index, events, debug_genes)

        _hi   = hi_genes  or {}
        _ts   = ts_genes  or {}
        _onco = oncogenes or set()
        _tsg  = tsgs      or set()

        # Fix 5: detect sex chromosome context for X-linked note
        chroms = {event["chrA"] for event in events} | {event["chrB"] for event in events}
        sex_chrom_context = any(c in {"chrX", "chrY"} for c in chroms)

        path_call, acmg_codes, path_evidence, acmg_score = classify_pathogenicity(
            gene_a, gene_b, label, reading_frame, mechanism,
            _hi, _ts, _onco, _tsg,
            sex_chrom_context=sex_chrom_context,
        )

        out.append([
            ";".join(variant_ids), gene_a, gene_b,
            orientation_a, orientation_b, orient_rel,
            strand_a, strand_b, relation,
            ";".join(unique_sv), ";".join(variant_types),
            mechanism, label, classification_reason, promoter_bp,
            reading_frame, support_score, acmg_score,
            path_call, acmg_codes, path_evidence,
        ])

    df = pd.DataFrame(out, columns=[
        "variant_ids", "geneA", "geneB",
        "break1_orientation", "break2_orientation", "break_orientation_relation",
        "strandA", "strandB", "strand_relation",
        "svtypes", "variant_types", "mechanism",
        "fusion_class", "classification_reason", "canonical_promoter_breakpoint",
        "reading_frame", "support_score", "acmg_score",
        "pathogenicity", "acmg_codes", "pathogenicity_evidence",
    ])

    if not df.empty:
        if min_support_score > 0:
            df = df[df["support_score"] >= min_support_score]

        # Fix 4: link reciprocal fusion pairs by shared variant ID.
        # A reciprocal pair is (geneA::geneB) and (geneB::geneA) that share
        # at least one variant ID.  We assign both rows the same
        # reciprocal_pair_id (the shared variant ID, or the first one).
        id_to_pair: dict = {}
        for _, row in df.iterrows():
            for vid in str(row["variant_ids"]).split(";"):
                id_to_pair.setdefault(vid, []).append((row["geneA"], row["geneB"]))

        reciprocal_ids = []
        for _, row in df.iterrows():
            vids = str(row["variant_ids"]).split(";")
            partner = None
            for vid in vids:
                pairs = id_to_pair.get(vid, [])
                for ga, gb in pairs:
                    if ga == row["geneB"] and gb == row["geneA"]:
                        partner = vid
                        break
                if partner:
                    break
            reciprocal_ids.append(partner or "")

        df = df.copy()
        df["reciprocal_pair_id"] = reciprocal_ids

        df = df.sort_values(
            ["acmg_score", "support_score", "geneA", "geneB"],
            ascending=[False, False, True, True],
        )
    return df


