# Pathogenicity classification — ClinGen Dosage Sensitivity + ACMG framework
# ---------------------------------------------------------------------------

_CLINGEN_PATH   = {3, 2}
_CLINGEN_BENIGN = {40, 0}

# Weights calibrated so that:
#   PVS1 alone (both HI, canonical, in-frame)     = 8  → Likely_Pathogenic
#   PVS1 + PM_INFRAME                              = 10 → Pathogenic
#   PS1 alone (both HI, canonical, any frame)      = 6  → Likely_Pathogenic
#   PM1 alone (one HI gene, canonical)             = 2  → Uncertain_Significance
#   PM1 + PM_INFRAME (one HI + canonical in-frame) = 6  → Likely_Pathogenic
#   PM_INFRAME alone (canonical in-frame, no HI)   = 4  → Uncertain_Significance
#   PP3 alone (canonical, frame unknown)            = 1  → Uncertain_Significance
#   PP3 + PM_EXPRESSED                             bumps borderline cases
_W = {
    "PVS1":       8,   # both HI (score 3 or 2), canonical, in-frame
    "PM_INFRAME": 2,   # canonical + in-frame (additive with HI criteria above)
    "PS1":        6,   # both HI, canonical, frame out-of-frame or unknown
    "PM1":        2,   # one gene HI, canonical
    "PM_INFRAME_NOHI": 4,  # canonical + in-frame, no ClinGen HI data at all
    "PP3":        1,   # canonical, frame undetermined
    "BP4":       -1,   # both genes dosage-insensitive
    "BP7":       -1,   # same gene both sides (intragenic artifact)
    "BS1":       -4,   # duplication, neither gene triplosensitive
}

_PATH_THRESHOLDS = [
    (10, "Pathogenic"),
    (6,  "Likely_Pathogenic"),
    (-5, "Uncertain_Significance"),
    (-9, "Likely_Benign"),
]


def _path_call(score):
    for threshold, label in _PATH_THRESHOLDS:
        if score >= threshold:
            return label
    return "Benign"


