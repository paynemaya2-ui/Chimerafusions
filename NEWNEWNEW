def get_exons_for_gene(exon_index, chrom, gene):
    chrom = norm_chr(chrom)
    seen  = set()
    exons = []
    for start, end, g, tx, frame in exon_index.get(chrom, []):
        if g == gene:
            key = (start, end)
            if key not in seen:
                seen.add(key)
                exons.append((start, end, frame))
    return sorted(exons)


def _supertx_bp_x(exons, exon_xs, exon_ws, intron_gap, bp_mid, x, width):
    """
    Map a genomic breakpoint coordinate into superTranscript pixel space.

    superTranscript space = only exonic bases are drawn, introns are
    collapsed to a fixed intron_gap pixels.  The breakpoint position is
    therefore computed relative to how far through the exonic sequence it
    falls, then translated into the pixel layout.

    If the breakpoint falls inside an exon it is positioned proportionally
    within that exon's pixel block.  If it falls in an intron it is placed
    at the nearest exon edge.  Falls before all exons → left edge;
    after all exons → right edge.
    """
    n = len(exons)
    if n == 0:
        return x + width / 2

    # Cumulative exonic bases before each exon (superTranscript offsets)
    total_exon_bases = sum(ee - es for es, ee, _ in exons)
    if total_exon_bases == 0:
        return x + width / 2

    # Build a mapping: for each exon, its [pixel_start, pixel_end]
    # exon_xs / exon_ws are already computed in genomic order
    # Find which exon contains bp_mid, or nearest
    for i, (es, ee, _) in enumerate(exons):
        if es <= bp_mid <= ee:
            # fraction through this exon
            frac = (bp_mid - es) / max(1, ee - es)
            return exon_xs[i] + frac * exon_ws[i]

    # bp is in an intron — place at the nearest exon boundary
    best_dist = None
    best_px   = x + width / 2
    for i, (es, ee, _) in enumerate(exons):
        for coord, px in [(es, exon_xs[i]), (ee, exon_xs[i] + exon_ws[i])]:
            d = abs(bp_mid - coord)
            if best_dist is None or d < best_dist:
                best_dist = d
                best_px   = px
    return best_px


def svg_gene_panel_exons(
    label, chrom, gene_start, gene_end, bp_start, bp_end,
    strand, x, y, width, color, exon_index, bp_label="BP", clip_id="",
):
    """
    Draw a gene panel in superTranscript space (Clinker-style).

    Exons are drawn proportional to their base-pair length and laid out
    left-to-right in transcript order with a fixed small intron_gap between
    them.  Introns are NOT drawn to scale — they are collapsed to the gap
    pixel width only.  This eliminates the problem where large introns
    compress small exons into invisibility.

    The breakpoint dashed line is placed at the superTranscript coordinate
    of the breakpoint, not at the raw genomic coordinate, so it always lands
    inside the correct exon block regardless of gene size.
    """
    track_y    = y + 75
    exon_h     = 24
    exon_top   = track_y - exon_h / 2
    min_exon_w = 10
    intron_gap = 8           # fixed collapsed intron width in pixels
    bp_mid     = int((bp_start + bp_end) / 2)

    pieces = []

    if clip_id:
        pieces.append(
            '<defs>'
            '<clipPath id="' + clip_id + '">'
            '<rect x="' + f'{x:.1f}' + '" y="' + f'{y:.1f}' + '" '
            'width="' + f'{width:.1f}' + '" height="200"/>'
            '</clipPath>'
            '</defs>'
        )
        pieces.append('<g clip-path="url(#' + clip_id + ')">')

    exons = get_exons_for_gene(exon_index, chrom, label)

    # For - strand genes the transcript runs right→left in genomic space.
    # Reverse the exon list so exon 1 (highest coordinate) is drawn first (leftmost).
    if strand == "-":
        exons = list(reversed(exons))

    n = len(exons)

    if not exons:
        # No exon data — draw a dashed line placeholder
        pieces.append(
            '<line x1="' + f'{x:.1f}' + '" y1="' + f'{track_y:.1f}' + '"'
            ' x2="' + f'{x + width:.1f}' + '" y2="' + f'{track_y:.1f}' + '"'
            ' stroke="#bbbbbb" stroke-width="2" stroke-dasharray="6 3"/>'
        )
        pieces.append(svg_text(
            _truncate_svg_text(label, 30),
            x + width / 2, track_y - 14,
            size=12, weight="bold", anchor="middle", fill="#444444",
        ))
        pieces.append(svg_text(
            "no exon data", x + width / 2, track_y + 18,
            size=10, anchor="middle", fill="#aaaaaa",
        ))
        bp_x = x + width / 2
    else:
        # ── SuperTranscript layout ────────────────────────────────────────────
        # Total pixels available for exon bodies (introns take fixed gap each)
        total_intron_px = intron_gap * (n - 1)
        avail           = max(width - total_intron_px, n * min_exon_w)

        # Distribute pixels proportional to exon length, with a min width
        lengths   = [ee - es for es, ee, _ in exons]
        total_len = sum(lengths) or 1
        exon_ws   = [max(min_exon_w, avail * ln / total_len) for ln in lengths]

        # Normalise if over budget
        total_w = sum(exon_ws)
        if total_w > avail:
            exon_ws = [w * avail / total_w for w in exon_ws]

        # Pixel x-start of each exon
        exon_xs = []
        cx = float(x)
        for i, ew in enumerate(exon_ws):
            exon_xs.append(cx)
            cx += ew + (intron_gap if i < n - 1 else 0)

        # Backbone line
        pieces.append(
            '<line x1="' + f'{x:.1f}' + '" y1="' + f'{track_y:.1f}' + '"'
            ' x2="' + f'{x + width:.1f}' + '" y2="' + f'{track_y:.1f}' + '"'
            ' stroke="#cccccc" stroke-width="2"/>'
        )

        # Strand arrow markers in intron gaps
        arrow_id = "sa_" + clip_id if clip_id else "sa"
        pieces.insert(0,
            '<defs><marker id="' + arrow_id + '" viewBox="0 0 8 8" refX="6" refY="4"'
            ' markerWidth="4" markerHeight="4" orient="0">'
            '<path d="M1 1L6 4L1 7" fill="none" stroke="#999999" stroke-width="1.5"'
            ' stroke-linecap="round" stroke-linejoin="round"/></marker></defs>'
        )
        if intron_gap >= 6:
            for i in range(n - 1):
                gm = exon_xs[i] + exon_ws[i] + intron_gap / 2
                pieces.append(
                    '<line x1="' + f'{gm - 1:.1f}' + '" y1="' + f'{track_y:.1f}' + '"'
                    ' x2="' + f'{gm:.1f}' + '" y2="' + f'{track_y:.1f}' + '"'
                    ' stroke="#999999" stroke-width="1"'
                    ' marker-end="url(#' + arrow_id + ')"/>'
                )

        # ── Breakpoint in superTranscript space ───────────────────────────────
        bp_x = _supertx_bp_x(exons, exon_xs, exon_ws, intron_gap, bp_mid, x, width)

        # Which exon contains the breakpoint?
        bp_exon_idx = None
        for i, (es, ee, _) in enumerate(exons):
            if es <= bp_mid <= ee:
                bp_exon_idx = i
                break
        if bp_exon_idx is None:
            dists = [min(abs(bp_mid - es), abs(bp_mid - ee)) for es, ee, _ in exons]
            bp_exon_idx = int(dists.index(min(dists)))

        # Exon numbers: after strand reversal, index 0 is always exon 1
        # (leftmost = first in transcript direction for both strands)
        n_exons = len(exons)
        def transcript_exon_number(idx):
            return idx + 1

        for i, (es, ee, frame) in enumerate(exons):
            ex1        = exon_xs[i]
            ew         = exon_ws[i]
            is_bp      = (i == bp_exon_idx)
            stroke_col = "#ffffff" if is_bp else "#00000033"
            stroke_w   = "2"      if is_bp else "0.5"
            pieces.append(
                '<rect x="' + f'{ex1:.1f}' + '" y="' + f'{exon_top:.1f}' + '"'
                ' width="' + f'{ew:.1f}' + '" height="' + str(exon_h) + '"'
                ' rx="2" fill="' + color + '"'
                ' stroke="' + stroke_col + '" stroke-width="' + stroke_w + '"/>'
            )
            if ew >= 14:
                pieces.append(svg_text(
                    f"e{transcript_exon_number(i)}",
                    ex1 + ew / 2,
                    track_y + exon_h / 2 + 13,
                    size=9, anchor="middle", fill="#777777",
                ))

        pieces.append(svg_text(
            label, x + width / 2, track_y - 14,
            size=12, weight="bold", anchor="middle", fill="#333333",
        ))

    if clip_id:
        pieces.append("</g>")

    bp_line_top = y + 14
    bp_line_bot = track_y + exon_h / 2 + 26
    pieces.append(
        '<line x1="' + f'{bp_x:.1f}' + '" y1="' + f'{bp_line_top:.1f}' + '"'
        ' x2="' + f'{bp_x:.1f}' + '" y2="' + f'{bp_line_bot:.1f}' + '"'
        ' stroke="#333333" stroke-width="1.5" stroke-dasharray="4 3"/>'
    )
    bp_lbl_w = len(bp_label) * 8 + 8
    pieces.append(
        '<rect x="' + f'{bp_x - bp_lbl_w/2:.1f}' + '" y="' + f'{y + 2:.1f}' + '"'
        ' width="' + f'{bp_lbl_w:.1f}' + '" height="14" rx="2"'
        ' fill="white" opacity="0.9"/>'
    )
    pieces.append(svg_text(
        bp_label, bp_x, y + 13,
        size=11, weight="bold", anchor="middle", fill="#333333",
    ))
    coord_str = f"{chrom}:{bp_mid:,}"
    coord_w   = len(coord_str) * 6 + 8
    pieces.append(
        '<rect x="' + f'{bp_x - coord_w/2:.1f}' + '" y="' + f'{bp_line_bot + 2:.1f}' + '"'
        ' width="' + f'{coord_w:.1f}' + '" height="13" rx="2"'
        ' fill="white" opacity="0.85"/>'
    )
    pieces.append(svg_text(
        coord_str, bp_x, bp_line_bot + 13,
        size=10, anchor="middle", fill="#555555",
    ))

    # Strand direction label — more informative than repeating the chrom name
    # which is already shown in the breakpoint coordinate above.
    chrom_label_y = bp_line_bot + 30
    strand_lbl = f"{'5′→3′' if strand == '+' else '3′→5′'}  {chrom}"
    pieces.append(svg_text(
        strand_lbl, x, chrom_label_y,
        size=10, weight="bold", anchor="start", fill="#aaaaaa",
    ))
    pieces.append(
        "<title>" + html.escape(label) + " " + chrom
        + ":g." + str(gene_start) + "_" + str(gene_end)
        + "; breakpoint " + str(bp_mid) + "</title>"
    )
    return "\n".join(pieces)


def render_fusion_svg(summary_row, event, gene_lookup, exon_index, out_file, svg_width=1200):
    gene_a  = event["geneA"]
    gene_b  = event["geneB"]
    chrom_a, gene_a_start, gene_a_end, strand_a = interval_for_gene(
        gene_lookup, gene_a, event["chrA"], event["startA"], event["endA"]
    )
    chrom_b, gene_b_start, gene_b_end, strand_b = interval_for_gene(
        gene_lookup, gene_b, event["chrB"], event["startB"], event["endB"]
    )

    W       = svg_width
    color_a = "#2f6f9f"
    color_b = "#b34a4a"
    margin  = 80          # wider margin so chrom labels have room left of panels
    gap     = 32
    pw      = (W - 2 * margin - gap) // 2

    # ── Vertical layout — each zone has explicit breathing room ──────────────
    title_y      = 48                       # title baseline
    badge_y      = title_y + 20            # FIX: was +14, badges were touching title
    path_badge_y = badge_y  + 40           # FIX: was +36, badge rects were 30px tall
    meta_y       = path_badge_y + 54       # metadata label row baseline
    strand_y     = meta_y  + 48            # strand info line baseline
    panel_top    = strand_y + 34           # FIX: was +22, BP label clipped strand line
    panel_h      = 190                     # exon track + coord label + chrom label row
    panel_bot    = panel_top + panel_h
    connector_zone = 55                    # vertical space for the arrows
    product_lbl_y = panel_bot + connector_zone + 10   # label sits above the bar
    product_y    = product_lbl_y + 18     # fusion bar top
    product_h    = 44
    score_y      = product_y + product_h + 34
    detail_y     = score_y  + 22
    H            = detail_y + 56

    left_x  = margin
    right_x = margin + pw + gap

    title_str   = f"{gene_a}::{gene_b}"
    class_label, class_color = display_fusion_class(summary_row["fusion_class"])
    path_raw    = str(summary_row.get("pathogenicity", "Uncertain_Significance"))
    path_label, path_color = display_pathogenicity(path_raw)

    svg = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}"'
        f' viewBox="0 0 {W} {H}">',
        "<style>text{font-family:Consolas,'Courier New',monospace}</style>",
        '<rect width="100%" height="100%" fill="#ffffff"/>',
        svg_text(title_str, W / 2, title_y, size=26, weight="bold"),
        svg_badge(class_label, W / 2, badge_y,      class_color),
        svg_badge(path_label,  W / 2, path_badge_y, path_color),
    ]

    # ── Metadata row ─────────────────────────────────────────────────────────
    meta_fields = [
        ("Variant ID",    summary_row["variant_ids"]),
        ("SV mechanism",  summary_row["mechanism"]),
        ("SV type",       summary_row["svtypes"]),
        ("Reading frame", summary_row["reading_frame"]),
        ("SV support",    str(summary_row["support_score"])),
        ("ACMG score",    str(summary_row["acmg_score"])),
    ]
    fs = W / (len(meta_fields) + 1)
    for i, (lbl, val) in enumerate(meta_fields):
        fx = fs * (i + 1)
        svg.append(svg_text(lbl, fx, meta_y, size=10, anchor="middle", fill="#999999"))
        svg.append(svg_text(
            _truncate_svg_text(val, 28), fx, meta_y + 16,
            size=12, weight="bold", anchor="middle", fill="#333333",
        ))

    # ── Strand / orientation info ─────────────────────────────────────────────
    orient_rel = str(summary_row.get("break_orientation_relation", ""))
    if orient_rel and orient_rel != "not_provided":
        strand_info = (
            f"Gene strands: {gene_label(gene_a, strand_a)} / {gene_label(gene_b, strand_b)}"
            f"  |  Strand relation: {summary_row['strand_relation']}"
            f"  |  Breakpoint orientations: {orient_rel}"
        )
    else:
        strand_info = (
            f"Gene strands: {gene_label(gene_a, strand_a)} / {gene_label(gene_b, strand_b)}"
            f"  |  Strand relation: {summary_row['strand_relation']}"
            f"  |  Breakpoint orientations: not provided in input"
        )
    svg.append(svg_text(
        _truncate_svg_text(strand_info, 120),
        W / 2, strand_y, size=11, fill="#666666",
    ))

    # ── Gene panels ───────────────────────────────────────────────────────────
    svg.append(svg_gene_panel_exons(
        gene_a, chrom_a, gene_a_start, gene_a_end,
        event["startA"], event["endA"], strand_a,
        left_x, panel_top, pw, color_a, exon_index,
        bp_label="Breakpoint 1", clip_id="clip_a",
    ))
    svg.append(svg_gene_panel_exons(
        gene_b, chrom_b, gene_b_start, gene_b_end,
        event["startB"], event["endB"], strand_b,
        right_x, panel_top, pw, color_b, exon_index,
        bp_label="Breakpoint 2", clip_id="clip_b",
    ))

    # ── Arrow connectors: panel BP → fusion bar ───────────────────────────────
    # Simple diagonal arrows — one arrowhead per colour, drawn as a thick line
    # with an inline filled triangle at the tip.  Starts from below the panel
    # bottom at the breakpoint x, angles inward to land at the top-centre of
    # each gene's half of the fusion bar.
    prod_x  = margin
    prod_w  = W - 2 * margin
    half_w  = prod_w / 2

    arrow_top_y  = panel_bot + 8          # arrow tail (just below panel)
    arrow_bot_y  = product_y              # arrow tip (top of fusion bar)
    head_size    = 10                     # arrowhead half-width and height

    # x positions
    ax      = left_x  + pw / 2           # left panel centre
    a_end_x = prod_x  + half_w / 2       # centre of gene-A half of fusion bar
    bx      = right_x + pw / 2           # right panel centre
    b_end_x = prod_x  + half_w + half_w / 2  # centre of gene-B half

    def _arrow(x1, y1, x2, y2, color, hs):
        """
        Draw a thick line from (x1,y1) to near (x2,y2), with a filled
        triangle arrowhead at the destination end.
        """
        import math
        dx = x2 - x1
        dy = y2 - y1
        length = math.hypot(dx, dy)
        if length == 0:
            return ""
        # Unit vector along the arrow
        ux, uy = dx / length, dy / length
        # Perpendicular unit vector
        px, py = -uy, ux
        # Tip of arrowhead
        tip_x, tip_y = x2, y2
        # Base of arrowhead (hs px back from tip)
        base_x = tip_x - ux * hs
        base_y = tip_y - uy * hs
        # Shaft ends just before the arrowhead base
        shaft_end_x = base_x
        shaft_end_y = base_y
        # Triangle corners
        l_x = base_x + px * hs * 0.6
        l_y = base_y + py * hs * 0.6
        r_x = base_x - px * hs * 0.6
        r_y = base_y - py * hs * 0.6
        return (
            f'<line x1="{x1:.1f}" y1="{y1:.1f}" x2="{shaft_end_x:.1f}" y2="{shaft_end_y:.1f}"'
            f' stroke="{color}" stroke-width="2.5" stroke-linecap="round"/>'
            f'<polygon points="{tip_x:.1f},{tip_y:.1f} {l_x:.1f},{l_y:.1f} {r_x:.1f},{r_y:.1f}"'
            f' fill="{color}"/>'
        )

    svg.append(_arrow(ax, arrow_top_y, a_end_x, arrow_bot_y, color_a, head_size))
    svg.append(_arrow(bx, arrow_top_y, b_end_x, arrow_bot_y, color_b, head_size))

    # ── Fusion product bar ────────────────────────────────────────────────────
    svg.append(svg_text(
        "Predicted fusion transcript", W / 2, product_lbl_y,
        size=13, weight="bold", fill="#444444",
    ))
    svg.append(
        f'<rect x="{prod_x}" y="{product_y}" width="{half_w:.1f}"'
        f' height="{product_h}" rx="2" fill="{color_a}" stroke="#111111" stroke-width="1"/>'
    )
    svg.append(
        f'<rect x="{prod_x + half_w:.1f}" y="{product_y}" width="{half_w:.1f}"'
        f' height="{product_h}" rx="2" fill="{color_b}" stroke="#111111" stroke-width="1"/>'
    )
    svg.append(svg_text(
        _truncate_svg_text(gene_a, 20),
        prod_x + half_w / 2,
        product_y + product_h / 2 + 6,
        size=16, weight="bold", fill="#ffffff",
    ))
    svg.append(svg_text(
        _truncate_svg_text(gene_b, 20),
        prod_x + half_w + half_w / 2,
        product_y + product_h / 2 + 6,
        size=16, weight="bold", fill="#ffffff",
    ))
    # Dividing line between the two gene halves
    svg.append(
        f'<line x1="{prod_x + half_w:.1f}" y1="{product_y}"'
        f' x2="{prod_x + half_w:.1f}" y2="{product_y + product_h}"'
        f' stroke="#ffffff" stroke-width="1.5" stroke-dasharray="4 3"/>'
    )

    # ── Score + reading frame ─────────────────────────────────────────────────
    frame_val   = str(summary_row["reading_frame"])
    frame_color = (
        "#2f7d4f" if frame_val == "IN_FRAME"
        else "#b35c1e" if frame_val == "OUT_OF_FRAME"
        else "#888888"
    )
    svg.append(svg_text(
        f"SV support score: {summary_row['support_score']}",
        W / 2 - 160, score_y, size=12, fill="#444444",
    ))
    svg.append(svg_text(
        f"Reading frame: {frame_val.replace('_', ' ').title()}",
        W / 2 + 160, score_y, size=12, fill=frame_color,
    ))

    # ── Classification + pathogenicity detail ─────────────────────────────────
    promoter   = str(summary_row.get("canonical_promoter_breakpoint", ""))
    reason     = str(summary_row.get("classification_reason", ""))
    acmg_codes = str(summary_row.get("acmg_codes", ""))
    path_evid  = str(summary_row.get("pathogenicity_evidence", ""))

    # Human-readable versions of internal values
    reason_labels = {
        "decision_matrix":        "strand/orientation matrix",
        "same_gene":              "same gene at both breakpoints",
        "missing_gene_strand":    "gene strand unknown",
        "no_decision_matrix_match": "no matrix entry for this SV/strand combination",
    }

    detail_parts = []
    if promoter and promoter not in {"", "nan"}:
        detail_parts.append(
            f"Promoter-retaining gene: {'gene A' if promoter == '1' else 'gene B'}"
        )
    if reason and reason not in {"", "nan"}:
        detail_parts.append(
            f"Classification basis: {reason_labels.get(reason, reason)}"
        )
    if acmg_codes and acmg_codes not in {"", ".", "nan"}:
        detail_parts.append(f"ACMG criteria applied: {acmg_codes}")

    max_detail_chars = (W - 2 * margin) // 7
    if detail_parts:
        svg.append(svg_text(
            _truncate_svg_text("  |  ".join(detail_parts), max_detail_chars),
            W / 2, detail_y, size=11, fill="#777777",
        ))
    if path_evid and path_evid not in {"", ".", "nan"}:
        # Capitalise first character for display
        display_evid = path_evid[0].upper() + path_evid[1:] if path_evid else path_evid
        svg.append(svg_text(
            _truncate_svg_text(display_evid, max_detail_chars),
            W / 2, detail_y + 18, size=10, fill="#aaaaaa",
        ))

    svg.append("</svg>")
    out_file.write_text("\n".join(svg) + "\n")


def write_html_index(summary, svg_dir, out_file,
                     variants_df=None, breakpoints_df=None,
                     intragenic_df=None, short_sv_df=None,
                     bed_file=None, igv_file=None,
                     sv_file=None, genome="hg38"):
    """
    Write a unified dark-theme HTML report containing:
    - Header with run stats
    - Filter bar by pathogenicity
    - One card per fusion with:
        * Full inline SVG (no external file links)
        * Collapsible detail — click the card header to expand/collapse
        * Complete metadata table
        * Colour-coded pathogenicity badge and ACMG score
    All SVGs are embedded directly so the file is fully self-contained.
    """
    import datetime as _dt

    # Resolve to absolute path so svg_path.exists() works regardless of
    # what the current working directory is when the function runs.
    svg_dir = Path(svg_dir).resolve()

    path_order = ["Pathogenic", "Likely_Pathogenic",
                  "Uncertain_Significance", "Likely_Benign", "Benign"]
    path_colors = {
        "Pathogenic":             "#c0392b",
        "Likely_Pathogenic":      "#e74c3c",
        "Uncertain_Significance": "#7f8c8d",
        "Likely_Benign":          "#27ae60",
        "Benign":                 "#1a6b3a",
    }
    frame_colors = {
        "IN_FRAME":     "#27ae60",
        "OUT_OF_FRAME": "#c0392b",
        "UNKNOWN":      "#7f8c8d",
    }

    # ── Build card HTML ───────────────────────────────────────────────────────
    cards = []
    for idx, (_, row) in enumerate(summary.iterrows()):
        gene_a   = html.escape(str(row["geneA"]))
        gene_b   = html.escape(str(row["geneB"]))
        path     = str(row.get("pathogenicity", "Uncertain_Significance"))
        pc       = path_colors.get(path, "#7f8c8d")
        path_lbl = path.replace("_", " ")
        acmg_sc  = str(row.get("acmg_score", ""))
        acmg_codes = html.escape(str(row.get("acmg_codes", ".")))
        frame    = str(row.get("reading_frame", "UNKNOWN"))
        fc       = frame_colors.get(frame, "#7f8c8d")
        frame_lbl = frame.replace("_", " ").title()
        mech     = html.escape(str(row.get("mechanism", "")).replace("_FUSION","").replace("_"," "))
        svtypes  = html.escape(str(row.get("svtypes", "")))
        fclass   = html.escape(str(row.get("fusion_class", "")))
        support  = html.escape(str(row.get("support_score", "")))
        evidence = html.escape(str(row.get("pathogenicity_evidence", "")))
        var_ids  = html.escape(str(row.get("variant_ids", ""))[:60])
        strand_a = html.escape(str(row.get("strandA", ".")))
        strand_b = html.escape(str(row.get("strandB", ".")))
        orient   = html.escape(str(row.get("break_orientation_relation", "")))
        recip    = str(row.get("reciprocal_pair_id", ""))
        recip_row = (
            f'<tr><th>Reciprocal pair</th>'
            f'<td colspan="3" class="recip">{html.escape(recip)}</td></tr>'
            if recip else ""
        )

        try:
            score_f = float(acmg_sc)
            score_col = ("#c0392b" if score_f >= 6
                         else "#e67e22" if score_f >= 0
                         else "#27ae60" if score_f <= -6
                         else "#7f8c8d")
        except ValueError:
            score_col = "#7f8c8d"

        # Inline SVG
        svg_name = f"{slug(row['geneA'])}_{slug(row['geneB'])}_fusion.svg"
        svg_path = svg_dir / svg_name
        svg_inline = ""
        if svg_path.exists():
            raw = svg_path.read_text(encoding="utf-8")
            raw = re.sub(r'<\?xml[^?]*\?>\s*', '', raw)
            # Make SVG responsive
            raw = re.sub(r'<svg ([^>]*?)width="[^"]*"', '<svg \\1', raw)
            raw = re.sub(r'<svg ([^>]*?)height="[^"]*"', '<svg \\1', raw)
            raw = re.sub(r'<svg ', '<svg style="width:100%;height:auto;display:block" ', raw, count=1)
            svg_inline = raw

        card_id = f"card_{idx}"
        cards.append(f"""
  <div class="card" data-path="{html.escape(path)}" id="{card_id}">
    <div class="card-header" onclick="toggleCard('{card_id}')">
      <div class="card-title">
        <span class="gene-a">{gene_a}</span>
        <span class="arrow">::</span>
        <span class="gene-b">{gene_b}</span>
      </div>
      <div class="card-badges">
        <span class="badge" style="background:{pc}">{html.escape(path_lbl)}</span>
        <span class="score-badge" style="color:{score_col}">ACMG {html.escape(acmg_sc)}</span>
