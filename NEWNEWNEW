import hashlib
import html
import re
from collections import defaultdict
from pathlib import Path

import pandas as pd


MAX_COORD = 500_000_000
WINDOW = 10_000

_INT_RE = re.compile(r"\d+")
_SLUG_RE = re.compile(r"[^A-Za-z0-9_.-]+")
CANONICAL_MATRIX = None


# ---------------------------------------------------------------------------
# Canonical-fusion decision matrix
# ---------------------------------------------------------------------------

def _get_canonical_matrix():
    global CANONICAL_MATRIX
    if CANONICAL_MATRIX is not None:
        return CANONICAL_MATRIX
    matrix = {}
    rows = [
        ("INVERSION",             "+", "+", False, None),
        ("INVERSION",             "+", "-", True,  1),
        ("INVERSION",             "-", "+", True,  1),
        ("INVERSION",             "-", "-", False, None),
        ("DUPLICATION",           "+", "+", True,  2),
        ("DUPLICATION",           "+", "-", False, None),
        ("DUPLICATION",           "-", "+", False, None),
        ("DUPLICATION",           "-", "-", True,  1),
        ("DELETION",              "+", "+", True,  1),
        ("DELETION",              "+", "-", False, None),
        ("DELETION",              "-", "+", False, None),
        ("DELETION",              "-", "-", True,  2),
        ("TRANSLOCATION",         "+", "+", True,  1),
        ("TRANSLOCATION",         "+", "-", False, None),
        ("TRANSLOCATION",         "-", "+", False, None),
        ("TRANSLOCATION",         "-", "-", True,  2),
        ("TRANSLOCATION_INVERTED","+", "-", False, None),
        ("TRANSLOCATION_INVERTED","+", "+", True,  1),
        ("TRANSLOCATION_INVERTED","-", "+", True,  1),
        ("TRANSLOCATION_INVERTED","-", "-", False, None),
    ]
    for variant_type, strand_a, strand_b, is_canonical, promoter_bp in rows:
        matrix[(variant_type, strand_a, strand_b)] = (is_canonical, promoter_bp)
    CANONICAL_MATRIX = matrix
    return CANONICAL_MATRIX


# ---------------------------------------------------------------------------
# Coordinate / string utilities
# ---------------------------------------------------------------------------

def norm_chr(chrom):
    chrom = str(chrom).strip()
    return chrom if chrom.startswith("chr") else "chr" + chrom


def extract_ints(value):
    vals = []
    for num in _INT_RE.findall(str(value)):
        val = int(num)
        if 0 < val <= MAX_COORD:
            vals.append(val)
    return vals


def slug(text):
    return _SLUG_RE.sub("_", str(text)).strip("_") or "fusion"


def fusion_key(gene_a, gene_b):
    return tuple(sorted([str(gene_a).upper(), str(gene_b).upper()]))


def stable_variant_id(fields):
    """
    Content-based 6-char hex ID.

    FIX: cast every numeric field to int before stringifying so that a field
    loaded as 1234.0 and one loaded as 1234 produce the same hash.  The old
    code joined raw str() values, which gave different hashes depending on
    whether pandas had inferred float or int dtype for a column.
    """
    parts = []
    for f in fields:
        if isinstance(f, float) and f.is_integer():
            parts.append(str(int(f)))
        else:
            parts.append(str(f))
    raw = "|".join(parts)
    return hashlib.md5(raw.encode("utf-8")).hexdigest()[:6].upper()


# ---------------------------------------------------------------------------
# Variant-type classification
# ---------------------------------------------------------------------------

def classify_variant_type(svtype, chr_a, chr_b,
                           orientation_a=".", orientation_b="."):
    """
    Derive the logical variant type from the SV type string, chromosome pair,
    and (when available) breakpoint orientations.

    FIX: the old version never produced TRANSLOCATION_INVERTED from headered
    input unless the input column literally said so.  Inter-chromosomal events
    with opposite orientations (+/- or -/+) are inverted translocations and
    must be classified here so they hit the correct rows of the canonical
    matrix downstream.
    """
    svtype = str(svtype).upper()

    # Explicit label in input always wins
    if svtype == "TRANSLOCATION_INVERTED":
        return "TRANSLOCATION_INVERTED"

    if norm_chr(chr_a) != norm_chr(chr_b):
        # Inter-chromosomal: orientation tells us whether it is inverted
        if orientation_a in {"+", "-"} and orientation_b in {"+", "-"}:
            if orientation_a != orientation_b:
                return "TRANSLOCATION_INVERTED"
        return "TRANSLOCATION"

    # Intra-chromosomal
    if svtype in {"DEL", "DELETION"}:
        return "DELETION"
    if svtype in {"DUP", "DUPLICATION"}:
        return "DUPLICATION"
    if svtype in {"INV", "INVERSION"}:
        return "INVERSION"
    if svtype == "BND":
        return "BREAKEND"
    return svtype or "UNKNOWN"


def normalize_event_type(value):
    value = str(value).strip().upper()
    mapping = {
        "DELETION":              "DEL",
        "DEL":                   "DEL",
        "DUPLICATION":           "DUP",
        "DUP":                   "DUP",
        "INVERSION":             "INV",
        "INV":                   "INV",
        "TRANSLOCATION":         "BND",
        "TRANSLOCATION_INVERTED":"TRANSLOCATION_INVERTED",
        "BND":                   "BND",
        "BREAKEND":              "BND",
    }
    return mapping.get(value, value)


def normalize_strand(value):
    value = str(value).strip()
    return value if value in {"+", "-"} else "."


def normalize_orientation(value):
    value = str(value).strip()
    return value if value in {"+", "-"} else "."


# ---------------------------------------------------------------------------
# Uncertain-breakpoint handling
# ---------------------------------------------------------------------------

def handle_uncertain_breakpoint(pos_start, pos_end, orientation):
    """
    FIX: the old code always took the first extracted integer, which is wrong
    for uncertain breakpoints (position_start != position_end).

    The R pipeline picks the *outermost* position relative to the orientation:
      + strand → upstream  = use pos_start (lower coordinate)
      - strand → upstream  = use pos_end   (higher coordinate)
    When the position is certain (start == end) this is a no-op.
    """
    if pos_start == pos_end:
        return pos_start
    if orientation == "+":
        return pos_start
    if orientation == "-":
        return pos_end
    # Orientation unknown → use midpoint as a safe fallback
    return (pos_start + pos_end) // 2


# ---------------------------------------------------------------------------
# Annotation parsing helpers
# ---------------------------------------------------------------------------

def parse_annotation_attributes(attr_text):
    attrs = {}
    for field in str(attr_text).split(";"):
        field = field.strip()
        if not field:
            continue
        if "=" in field:
            key, value = field.split("=", 1)
        elif " " in field:
            key, value = field.split(" ", 1)
            value = value.strip().strip('"')
        else:
            continue
        attrs[key.strip()] = value.strip()
    return attrs


# ---------------------------------------------------------------------------
# Gene annotation loading
# ---------------------------------------------------------------------------

def read_gene_annotations(gene_file=None, annotation_file=None):
    if annotation_file is not None and Path(annotation_file).exists():
        return load_genes_from_gencode(annotation_file)
    if gene_file is None or not Path(gene_file).exists():
        raise FileNotFoundError(
            "No gene annotation found. Provide --gene-file or --gencode-file."
        )
    return load_genes(gene_file)


def _build_gene_index(rows):
    gene_index = defaultdict(list)
    gene_lookup = {}
    chrom_sizes = defaultdict(int)
    for row in rows:
        start, end = sorted([int(row["start"]), int(row["end"])])
        gene   = str(row["gene"])
        chrom  = row["chr"]
        strand = row["strand"]
        gene_index[chrom].append((start, end, gene, strand))
        chrom_sizes[chrom] = max(chrom_sizes[chrom], end)
        gene_lookup.setdefault(gene, []).append((chrom, start, end, strand))
    for chrom in gene_index:
        gene_index[chrom].sort()
    return gene_index, gene_lookup, chrom_sizes


def load_genes(gene_file):
    genes = pd.read_csv(gene_file, sep="\t", header=None, comment="#")
    if genes.shape[1] < 4:
        raise ValueError(
            "Gene annotation must have at least 4 BED columns: chr, start, end, gene"
        )
    keep_cols = [0, 1, 2, 3]
    names = ["chr", "start", "end", "gene"]
    if genes.shape[1] >= 6:
        keep_cols.append(5)
        names.append("strand")
    genes = genes.iloc[:, keep_cols]
    genes.columns = names
    if "strand" not in genes.columns:
        genes["strand"] = "."
    genes["start"]  = pd.to_numeric(genes["start"],  errors="coerce")
    genes["end"]    = pd.to_numeric(genes["end"],    errors="coerce")
    genes           = genes.dropna()
    genes["chr"]    = genes["chr"].apply(norm_chr)
    genes["start"]  = genes["start"].astype(int)
    genes["end"]    = genes["end"].astype(int)
    genes["strand"] = genes["strand"].apply(normalize_strand)
    genes           = genes[~genes["gene"].astype(str).str.startswith("ENSG")]
    rows = genes.to_dict("records")
    gene_index, gene_lookup, chrom_sizes = _build_gene_index(rows)
    exon_index = defaultdict(list)
    return gene_index, gene_lookup, chrom_sizes, exon_index


def _is_ensg(name):
    """Return True if name looks like a raw Ensembl gene ID (no symbol resolved)."""
    return bool(name) and re.match(r"ENSG\d+", str(name), re.IGNORECASE) is not None


def load_genes_from_gencode(gencode_file):
    opener    = gzip.open if str(gencode_file).endswith(".gz") else open
    gene_rows = []
    exon_rows = []
    # Track which transcript_ids are MANE Select or Ensembl canonical so we
    # can prefer them over all other transcripts for reading-frame calculation.
    # Keys: gene symbol (upper), value: set of preferred transcript_ids.
    canonical_tx: dict = {}

    with opener(gencode_file, "rt") as handle:
        for line in handle:
            if not line or line.startswith("#"):
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 9:
                continue
            feature = parts[2]
            attrs   = parse_annotation_attributes(parts[8])

            if feature == "gene":
                gene = attrs.get("gene_name") or attrs.get("Name")
                if not gene:
                    fallback = attrs.get("gene_id") or attrs.get("ID")
                    if _is_ensg(fallback):
                        continue
                    gene = fallback
                if not gene:
                    continue
                # Filter out any record where the resolved name is still a raw
                # Ensembl ID — this happens in GENCODE when a novel/uncharacterised
                # locus has no approved symbol and gene_name is set to the ENSG ID.
                if _is_ensg(gene):
                    continue
                gene_rows.append({
                    "chr":    norm_chr(parts[0]),
                    "start":  int(parts[3]),
                    "end":    int(parts[4]),
                    "gene":   gene,
                    "strand": normalize_strand(parts[6]),
                })

            elif feature == "transcript":
                # Fix 9: capture MANE Select and Ensembl canonical transcripts.
                # GENCODE GTF tags are semicolon-separated in the attributes
                # field as 'tag "MANE_Select"' or 'tag "Ensembl_canonical"'.
                gene = attrs.get("gene_name")
                tx   = attrs.get("transcript_id", "")
                if gene and tx:
                    tag_str = attrs.get("tag", "")
                    is_mane      = "MANE_Select"        in tag_str
                    is_canonical = "Ensembl_canonical"  in tag_str
                    if is_mane or is_canonical:
                        canonical_tx.setdefault(gene.upper(), set()).add(tx)

            elif feature == "CDS":
                gene = attrs.get("gene_name")
                if not gene or _is_ensg(gene):
                    continue
                transcript = attrs.get("transcript_id", "")
                frame_raw  = parts[7]
                try:
                    frame = int(frame_raw)
                except ValueError:
                    frame = -1
                if frame >= 0:
                    exon_rows.append((
                        norm_chr(parts[0]),
                        int(parts[3]),
                        int(parts[4]),
                        gene,
                        transcript,
                        frame,
                    ))

    if not gene_rows:
        raise ValueError(
            f"No gene records found in GENCODE annotation: {gencode_file}"
        )
    gene_index, gene_lookup, chrom_sizes = _build_gene_index(gene_rows)

    # Fix 9: build exon_index preferring canonical transcripts.
    # For each gene, if any canonical tx was found, keep only CDS records
    # belonging to those transcripts.  Fall back to all transcripts when no
    # canonical tx was identified (e.g. BED-only annotation).
    exon_index = defaultdict(list)
    for chrom, start, end, gene, tx, frame in exon_rows:
        preferred = canonical_tx.get(gene.upper())
        if preferred and tx not in preferred:
            continue   # skip non-canonical transcripts when we have better ones
        exon_index[chrom].append((start, end, gene, tx, frame))
    for chrom in exon_index:
        exon_index[chrom].sort()

    n_canonical = sum(len(v) for v in canonical_tx.values())
    print(f"Canonical transcripts identified: {len(canonical_tx)} genes "
          f"({n_canonical} transcript IDs)")
    return gene_index, gene_lookup, chrom_sizes, exon_index


# ---------------------------------------------------------------------------
# Reading-frame prediction  (complete rewrite)
# ---------------------------------------------------------------------------

def _coding_bases_before(exon_index, chrom, breakpoint, gene, strand,
                         _debug=False):
    """
    Count the number of CDS bases that `gene` contributes *before* the
    breakpoint (in transcript direction).

    For a + strand gene "before" means coordinates < breakpoint.
    For a - strand gene "before" means coordinates > breakpoint (the
    transcript runs right-to-left, so upstream = higher genomic coordinate).

    Returns -1 when the gene has no CDS records on this chromosome, which
    causes predict_reading_frame to return UNKNOWN.

    Diagnostic: set _debug=True to print the exon lookup result, which helps
    identify when a gene has no CDS records because its canonical transcript
    was not found in the GTF (e.g. MANE Select tag absent for that gene).
    """
    chrom = norm_chr(chrom)
    exons = [
        (start, end)
        for start, end, g, _tx, _frame in exon_index.get(chrom, [])
        if g == gene
    ]
    if _debug:
        print(f"  [frame debug] {gene} on {chrom} strand={strand} bp={breakpoint}: "
              f"{len(exons)} CDS exon(s) found")
        if exons:
            print(f"    exon range: {min(s for s,e in exons):,} – {max(e for s,e in exons):,}")
    if not exons:
        return -1

    total = 0
    if strand == "+":
        for start, end in sorted(exons):
            if end < breakpoint:
                total += end - start + 1          # fully upstream of BP
            elif start <= breakpoint <= end:
                total += breakpoint - start       # partial exon at BP
                break
            else:
                break                             # past BP, nothing more
    else:
        # "-" strand: transcript runs from high coord to low coord.
        # "Before the breakpoint" in transcript terms = high genomic coords.
        for start, end in sorted(exons, reverse=True):
            if start > breakpoint:
                total += end - start + 1          # fully upstream of BP
            elif start <= breakpoint <= end:
                total += end - breakpoint         # partial exon at BP
                break
            else:
                break

    if _debug:
        print(f"    coding bases before BP: {total}  (phase = {total % 3})")
    return total


def predict_reading_frame(exon_index, event, debug_genes=None):
    """
    Predict IN_FRAME / OUT_OF_FRAME / UNKNOWN for a single fusion event.

    phase_A = coding bases gene A contributes up to BP1, mod 3
    phase_B = coding bases gene B contributes from BP2 onward, mod 3

    If (phase_A + phase_B) % 3 == 0 the reading frame is preserved.

    debug_genes: optional set of gene symbols; when either gene matches,
    prints CDS lookup details to stdout to help diagnose wrong frame calls.
    """
    bp_a = int((event["startA"] + event["endA"]) // 2)
    bp_b = int((event["startB"] + event["endB"]) // 2)

    strand_a = event.get("strandA", ".")
    strand_b = event.get("strandB", ".")

    _dbg_a = debug_genes and event["geneA"].upper() in {g.upper() for g in debug_genes}
    _dbg_b = debug_genes and event["geneB"].upper() in {g.upper() for g in debug_genes}
    if _dbg_a or _dbg_b:
        print(f"[frame debug] {event['geneA']}::{event['geneB']} "
              f"bp_a={bp_a:,} bp_b={bp_b:,}")

    bases_a = _coding_bases_before(
        exon_index, event["chrA"], bp_a, event["geneA"], strand_a,
        _debug=bool(_dbg_a),
    )
    bases_b = _coding_bases_before(
        exon_index, event["chrB"], bp_b, event["geneB"], strand_b,
        _debug=bool(_dbg_b),
    )

    if bases_a < 0 or bases_b < 0:
        return "UNKNOWN"

    phase_a = bases_a % 3
    phase_b = bases_b % 3
    return "IN_FRAME" if (phase_a + phase_b) % 3 == 0 else "OUT_OF_FRAME"


def consensus_reading_frame(exon_index, events, debug_genes=None):
    """
    Fix 1 / 6: call reading frame across ALL supporting events for a fusion
    and return the majority call.

    Using only events[0] was wrong when a gene pair had multiple supporting
    SVs at different breakpoint positions — a single uncertain breakpoint could
    flip the frame call for the whole fusion.  We now call every event and take
    the most common result.  UNKNOWN votes are only used as a tiebreaker: if
    any definite call (IN_FRAME or OUT_OF_FRAME) is present, UNKNOWN is ignored.
    If all events return UNKNOWN the result is UNKNOWN.
    """
    calls = [predict_reading_frame(exon_index, ev, debug_genes) for ev in events]
    definite = [c for c in calls if c != "UNKNOWN"]
    if not definite:
        return "UNKNOWN"
    return most_common(definite)


# ---------------------------------------------------------------------------
# Gene lookup
# ---------------------------------------------------------------------------

def get_genes(gene_index, chrom, pos):
    return set(get_gene_hits(gene_index, chrom, pos).keys())


def get_gene_hits(gene_index, chrom, pos):
    chrom = norm_chr(chrom)
    if chrom not in gene_index:
        return {}
    hits = {}
    for start, end, gene, strand in gene_index[chrom]:
        if start > pos:
            break
        if start <= pos <= end:
            hits[gene] = {
                "gene": gene, "chrom": chrom,
                "start": start, "end": end, "strand": strand,
            }
    return hits


# ---------------------------------------------------------------------------
# SV loading
# ---------------------------------------------------------------------------

def load_svs(sv_file):
    with open(sv_file) as handle:
        first_line = handle.readline().strip()
    if "break1_chromosome" in first_line and "break2_chromosome" in first_line:
        return load_headered_svs(sv_file)
    return load_legacy_svs(sv_file)


def load_legacy_svs(sv_file):
    """
    Tab-delimited headerless format:
      chrA  startA  endA  chrB  startB  endB  svtype
    """
    rows     = []
    bad_rows = 0
    with open(sv_file) as handle:
        for lineno, line in enumerate(handle, start=1):
            parts = re.split(r"\t+", line.strip())
            if len(parts) < 7:
                bad_rows += 1
                continue
            chr_a  = norm_chr(parts[0])
            chr_b  = norm_chr(parts[3])
            svtype = parts[-1].strip().upper()
            coords_a, coords_b = [], []
            for field in parts[1:3]:
                coords_a.extend(extract_ints(field))
            for field in parts[4:6]:
                coords_b.extend(extract_ints(field))
            if len(coords_a) < 2 or len(coords_b) < 2:
                bad_rows += 1
                continue
            a, b = coords_a[:2]
            c, d = coords_b[:2]
            variant_id   = stable_variant_id([lineno, chr_a, a, b, chr_b, c, d, svtype])
            variant_type = classify_variant_type(svtype, chr_a, chr_b)
            rows.append([
                variant_id, variant_type,
                chr_a, a, b,
                chr_b, c, d,
                svtype, ".", ".",
            ])
    sv = pd.DataFrame(rows, columns=[
        "variant_id", "variant_type",
        "chrA", "startA", "endA",
        "chrB", "startB", "endB",
        "svtype", "break1_orientation", "break2_orientation",
    ])
    return sv, bad_rows


def load_headered_svs(sv_file):
    """
    MAVIS-style headered TSV with break1_*/break2_* columns.

    FIX 1 (uncertain breakpoints): the old code always took coords[n][0],
    i.e. the first extracted integer regardless of position_start vs
    position_end.  We now call handle_uncertain_breakpoint() which picks the
    outermost coordinate relative to the breakpoint orientation, matching the
    R pipeline's handle_uncertain_breakpoint() helper.

    FIX 2 (TRANSLOCATION_INVERTED): classify_variant_type() now receives the
    parsed orientations so it can derive TRANSLOCATION_INVERTED from
    orientation evidence rather than relying on the input label alone.
    """
    sv       = pd.read_csv(sv_file, sep="\t", comment="#")
    required = {
        "break1_chromosome", "break1_position_start", "break1_position_end",
        "break2_chromosome", "break2_position_start", "break2_position_end",
    }
    missing = required - set(sv.columns)
    if missing:
        raise ValueError(
            f"Input is missing required columns: {', '.join(sorted(missing))}"
        )
    if "event_type" not in sv.columns and "svtype" not in sv.columns:
        raise ValueError("Input must contain either event_type or svtype")

    rows     = []
    bad_rows = 0
    for row in sv.itertuples(index=True):
        idx   = row.Index
        chr_a = norm_chr(row.break1_chromosome)
        chr_b = norm_chr(row.break2_chromosome)
        svtype = normalize_event_type(
            row.event_type if hasattr(row, "event_type") else row.svtype
        )

        # Parse all four position boundaries
        s1 = extract_ints(row.break1_position_start)
        e1 = extract_ints(row.break1_position_end)
        s2 = extract_ints(row.break2_position_start)
        s3 = extract_ints(row.break2_position_start)   # reused for clarity
        e2 = extract_ints(row.break2_position_end)

        if not s1 or not e1 or not s2 or not e2:
            bad_rows += 1
            continue

        break1_orientation = normalize_orientation(
            row.break1_orientation if hasattr(row, "break1_orientation") else "."
        )
        break2_orientation = normalize_orientation(
            row.break2_orientation if hasattr(row, "break2_orientation") else "."
        )

        # FIX: use orientation-aware outermost coordinate for uncertain BPs
        a = handle_uncertain_breakpoint(s1[0], e1[0], break1_orientation)
        b = e1[0]   # end of break1 interval (kept for span representation)
        c = handle_uncertain_breakpoint(s2[0], e2[0], break2_orientation)
        d = e2[0]   # end of break2 interval

        variant_id   = stable_variant_id([idx + 1, chr_a, a, b, chr_b, c, d, svtype])
        # FIX: pass orientations so inter-chromosomal events with mismatched
        # orientations are correctly labelled TRANSLOCATION_INVERTED
        variant_type = classify_variant_type(
            svtype, chr_a, chr_b, break1_orientation, break2_orientation
        )
        rows.append([
            variant_id, variant_type,
            chr_a, a, b,
            chr_b, c, d,
            svtype, break1_orientation, break2_orientation,
        ])

    parsed = pd.DataFrame(rows, columns=[
        "variant_id", "variant_type",
        "chrA", "startA", "endA",
        "chrB", "startB", "endB",
        "svtype", "break1_orientation", "break2_orientation",
    ])
    return parsed, bad_rows


# ---------------------------------------------------------------------------
# Fusion collection
# ---------------------------------------------------------------------------

def classify_mechanism(svtypes):
    svset = set(svtypes)
    if svset == {"DEL"}:
        return "DELETION_FUSION"
    if svset == {"DUP"}:
        return "DUPLICATION_FUSION"
    if svset == {"INV"}:
        return "INVERSION_FUSION"
    if "BND" in svset:
        return "TRANSLOCATION_FUSION"
    if len(svset) > 1:
        return "COMPLEX_SV_FUSION"
    return "UNKNOWN"


def exact_breakpoint_hits(gene_index, chrom, bp_start, bp_end):
    """
    Return all genes whose genomic interval overlaps [bp_start, bp_end].

    Replaces the old scan_breakpoint_hits() which sampled up to 20 points
    across [start−WINDOW, end+WINDOW].  That approach had two problems:
      1. For single-position breakpoints (start==end) the step size was 1,
         so the 20-point cap meant only a 20bp window was actually searched
         — far less than the intended WINDOW=10,000bp expansion.
      2. The WINDOW expansion pulled in genes up to 10kb away from the
         breakpoint, generating spurious fusion candidates.

    Exact interval overlap is both faster (one sorted-list walk) and correct:
    every gene whose interval contains any part of [bp_start, bp_end] is
    returned, nothing more.  No WINDOW expansion needed.
    """
    chrom = norm_chr(chrom)
    hits  = {}
    for start, end, gene, strand in gene_index.get(chrom, []):
        if start > bp_end:
            break                    # gene_index is sorted; no further overlaps
        if end >= bp_start:          # overlaps [bp_start, bp_end]
            hits[gene] = {
                "gene": gene, "chrom": chrom,
                "start": start, "end": end, "strand": strand,
            }
    return hits


def scan_breakpoint_genes(gene_index, row, side):
    """Thin wrapper kept for any external callers."""
    bp_start = int(row[f"start{side}"])
    bp_end   = int(row[f"end{side}"])
    chrom    = norm_chr(row[f"chr{side}"])
    return set(exact_breakpoint_hits(gene_index, chrom, bp_start, bp_end).keys())


def strand_relation(strand_a, strand_b):
    if strand_a not in {"+", "-"} or strand_b not in {"+", "-"}:
        return "UNKNOWN"
    return "SAME_STRAND" if strand_a == strand_b else "OPPOSITE_STRAND"


MIN_FUSION_DISTANCE = 10_000   # bp; intrachromosomal fusions closer than this
                               # are likely artifacts or intragenic events


def collect_fusions(sv, gene_index, min_fusion_distance=MIN_FUSION_DISTANCE):
    """
    Build the fusion edge graph.

    Improvements applied:
    1. exact_breakpoint_hits() replaces the old sampled-point scan.
    2. Self-fusions (geneA == geneB) are separated into intragenic_events
       rather than mixed into the main fusion table.
    3. Intrachromosomal pairs closer than min_fusion_distance are flagged
       and excluded from the main summary (written to short_sv_events).
    """
    edge_counts      = defaultdict(int)
    edge_svtypes     = defaultdict(list)
    edge_events      = defaultdict(list)
    intragenic_rows  = []   # item 2: same-gene events
    short_sv_rows    = []   # item 3: too-close intrachromosomal events
    breakpoint_rows  = []
    debug_hits       = 0

    for _, row in sv.iterrows():
        bp_start_a = int(row["startA"])
        bp_end_a   = int(row["endA"])
        bp_start_b = int(row["startB"])
        bp_end_b   = int(row["endB"])

        hits_a = exact_breakpoint_hits(gene_index, row["chrA"], bp_start_a, bp_end_a)
        hits_b = exact_breakpoint_hits(gene_index, row["chrB"], bp_start_b, bp_end_b)
        genes_a = set(hits_a.keys())
        genes_b = set(hits_b.keys())

        for side, hits, bp_s, bp_e in [
            ("A", hits_a, bp_start_a, bp_end_a),
            ("B", hits_b, bp_start_b, bp_end_b),
        ]:
            for hit in hits.values():
                breakpoint_rows.append({
                    "variant_id":        row["variant_id"],
                    "breakpoint_side":   side,
                    "chrom":             row[f"chr{side}"],
                    "breakpoint_start":  bp_s,
                    "breakpoint_end":    bp_e,
                    "gene":              hit["gene"],
                    "gene_start":        hit["start"],
                    "gene_end":          hit["end"],
                    "gene_strand":       hit["strand"],
                    "variant_type":      row["variant_type"],
                    "svtype":            row["svtype"],
                    "break1_orientation": row["break1_orientation"],
                    "break2_orientation": row["break2_orientation"],
                })

        if genes_a and genes_b:
            debug_hits += 1

        for gene_a in genes_a:
            for gene_b in genes_b:

                # Item 2: separate self-fusions (intragenic events)
                if gene_a == gene_b:
                    hit = hits_a.get(gene_a) or hits_b.get(gene_b, {})
                    intragenic_rows.append({
                        "variant_id":   row["variant_id"],
                        "gene":         gene_a,
                        "chrom":        row["chrA"],
                        "breakpoint_A": bp_start_a,
                        "breakpoint_B": bp_start_b,
                        "svtype":       row["svtype"],
                        "variant_type": row["variant_type"],
                    })
                    continue

                # Item 3: flag intrachromosomal events that are too close
                if row["chrA"] == row["chrB"]:
                    distance = abs(bp_start_b - bp_end_a)
                    if distance < min_fusion_distance:
                        short_sv_rows.append({
                            "variant_id":   row["variant_id"],
                            "geneA":        gene_a,
                            "geneB":        gene_b,
                            "chrom":        row["chrA"],
                            "breakpoint_A": bp_start_a,
                            "breakpoint_B": bp_start_b,
                            "distance_bp":  distance,
                            "svtype":       row["svtype"],
                        })
                        continue

                key   = (gene_a, gene_b)
                hit_a = hits_a[gene_a]
                hit_b = hits_b[gene_b]
                edge_counts[key]  += 1
                edge_svtypes[key].append(row["svtype"])
                edge_events[key].append({
                    "variant_id":         row["variant_id"],
                    "variant_type":       row["variant_type"],
                    "break1_orientation": row["break1_orientation"],
                    "break2_orientation": row["break2_orientation"],
                    "geneA":   gene_a,
                    "geneB":   gene_b,
                    "strandA": hit_a["strand"],
                    "strandB": hit_b["strand"],
                    "strand_relation": strand_relation(hit_a["strand"], hit_b["strand"]),
                    "chrA":   row["chrA"], "startA": bp_start_a, "endA": bp_end_a,
                    "chrB":   row["chrB"], "startB": bp_start_b, "endB": bp_end_b,
                    "svtype": row["svtype"],
                })

    breakpoint_annotations = pd.DataFrame(breakpoint_rows)
    intragenic_events      = pd.DataFrame(intragenic_rows)
    short_sv_events        = pd.DataFrame(short_sv_rows)
    return (edge_counts, edge_svtypes, edge_events,
            breakpoint_annotations, intragenic_events, short_sv_events,
            debug_hits)


