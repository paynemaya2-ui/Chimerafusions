// ── Force-directed network graph ──────────────────────────────────────────────
let networkInitialised = false;
function initNetwork() {{
  if (networkInitialised) return;
  networkInitialised = true;
  const canvas = document.getElementById('network-canvas');
  if (!canvas || !NET_NODES.length) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;

  const nodeMap = {{}};
  NET_NODES.forEach(n => {{
    nodeMap[n.id] = {{
      id:n.id, count:n.count,
      x: W/2 + (Math.random()-0.5)*400,
      y: H/2 + (Math.random()-0.5)*300,
      vx:0, vy:0,
      r: Math.max(6, Math.min(22, 4 + n.count*3)),
    }};
  }});
  const nodes = Object.values(nodeMap);
  const edges = NET_EDGES.map(e => ({{
    ...e, source:nodeMap[e.source], target:nodeMap[e.target]
  }})).filter(e => e.source && e.target);

  function tick() {{
    const K=110, REPEL=2800, DAMP=0.86, G=0.012;
    edges.forEach(e => {{
      const dx=e.target.x-e.source.x, dy=e.target.y-e.source.y;
      const d=Math.sqrt(dx*dx+dy*dy)||1, f=(d-K)*0.03;
      e.source.vx+=dx/d*f; e.source.vy+=dy/d*f;
      e.target.vx-=dx/d*f; e.target.vy-=dy/d*f;
    }});
    nodes.forEach(a => {{
      nodes.forEach(b => {{
        if (a===b) return;
        const dx=b.x-a.x, dy=b.y-a.y, d2=dx*dx+dy*dy||1;
        const f=REPEL/d2, ds=Math.sqrt(d2);
        a.vx-=dx/ds*f; a.vy-=dy/ds*f;
      }});
      a.vx+=(W/2-a.x)*G; a.vy+=(H/2-a.y)*G;
      a.vx*=DAMP; a.vy*=DAMP;
      a.x+=a.vx; a.y+=a.vy;
      a.x=Math.max(a.r, Math.min(W-a.r, a.x));
      a.y=Math.max(a.r, Math.min(H-a.r, a.y));
    }});
  }}

  function draw() {{
    ctx.fillStyle='#0d1117'; ctx.fillRect(0,0,W,H);
    edges.forEach(e => {{
      if (!e.source||!e.target) return;
      ctx.beginPath();
      ctx.moveTo(e.source.x,e.source.y);
      ctx.lineTo(e.target.x,e.target.y);
      ctx.strokeStyle=e.color||'#4a9eff';
      ctx.globalAlpha=0.3;
      ctx.lineWidth=Math.max(0.5,Math.abs(e.acmg||0)*0.2);
      ctx.stroke(); ctx.globalAlpha=1;
    }});
    nodes.forEach(n => {{
      ctx.beginPath(); ctx.arc(n.x,n.y,n.r,0,Math.PI*2);
      ctx.fillStyle='#4a9eff'; ctx.fill();
      ctx.strokeStyle='#0d1117'; ctx.lineWidth=1.5; ctx.stroke();
      if (n.r>8) {{
        ctx.fillStyle='#fff';
        ctx.font=`bold ${{Math.min(n.r-2,11)}}px monospace`;
        ctx.textAlign='center'; ctx.textBaseline='middle';
        const lbl=n.id.length>9?n.id.slice(0,8)+'\u2026':n.id;
        ctx.fillText(lbl,n.x,n.y);
      }}
    }});
  }}

  let frame=0;
  function loop() {{
    for(let i=0;i<4;i++) tick();
    draw(); frame++;
    if(frame<250) requestAnimationFrame(loop);
  }}
  requestAnimationFrame(loop);

  let dragging=null, offX=0, offY=0;
  function getMouse(e) {{
    const r=canvas.getBoundingClientRect();
    return [(e.clientX-r.left)*(W/r.width),(e.clientY-r.top)*(H/r.height)];
  }}
  canvas.addEventListener('mousedown', e => {{
    const [mx,my]=getMouse(e);
    dragging=nodes.find(n=>Math.hypot(n.x-mx,n.y-my)<n.r+4)||null;
    if(dragging){{offX=mx-dragging.x;offY=my-dragging.y;}}
  }});
  canvas.addEventListener('mousemove', e => {{
    const [mx,my]=getMouse(e);
    if(dragging){{dragging.x=mx-offX;dragging.y=my-offY;dragging.vx=0;dragging.vy=0;draw();}}
    const hit=nodes.find(n=>Math.hypot(n.x-mx,n.y-my)<n.r+4);
    canvas.title=hit?`${{hit.id}} — ${{hit.count}} fusion${{hit.count!==1?'s':''}}`: '';
  }});
  canvas.addEventListener('mouseup',()=>{{dragging=null;}});
}}

