    raw_fusion    = _df_to_html_table(summary,        "tbl-fusion")
    raw_variants  = _df_to_html_table(variants_df,    "tbl-variants")
    raw_bpannot   = _df_to_html_table(breakpoints_df, "tbl-bpannot")
