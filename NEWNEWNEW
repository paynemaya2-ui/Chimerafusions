    files_rows = "".join([
        _file_row("Fusion summary",     out_file,   "All inter-gene fusions ranked by ACMG score — the main result",  "#4a9eff"),
        _file_row("BED breakpoints",    bed_file,   "Load into IGV or UCSC browser for locus navigation",              "#e67e22"),
        _file_row("IGV session",        igv_file,   "File → Open Session in IGV to jump to top fusions",               "#e67e22"),
        _file_row("SV source",          sv_file,    "Original input SV file",                                           "#7a8aa0"),
        _file_row("This report",        out_file,   "Self-contained unified HTML report — share this one file",        "#27ae60"),
    ])

    igv_instructions = f"""
<div class="instr-card">
  <div class="instr-title" style="color:#e67e22">&#127381; IGV Desktop</div>
  <ol>
    <li>Open IGV and ensure genome is set to <code>{_html.escape(genome)}</code></li>
    <li>File → Open Session → select <code>chimera_igv_session.xml</code></li>
    <li>IGV jumps to the top-priority fusion locus with breakpoints pre-loaded</li>
    <li>Alternatively drag <code>fusion_breakpoints.bed</code> directly onto IGV</li>
  </ol>
</div>
<div class="instr-card">
  <div class="instr-title" style="color:#8e44ad">&#127760; UCSC Browser</div>
  <ol>
    <li>Host <code>fusion_breakpoints.bed</code> on a web-accessible server or use UCSC's upload</li>
    <li>Go to <a href="https://genome.ucsc.edu/cgi-bin/hgCustom" target="_blank" style="color:#4a9eff">genome.ucsc.edu → My Data → Custom Tracks</a></li>
    <li>Upload the BED file or paste its URL and click Submit</li>
    <li>Fusions are colour-coded by pathogenicity class</li>
  </ol>
</div>"""

    # ══════════════════════════════════════════════════════════════════════════
    # NEW FEATURES — all pure SVG/JS, no external dependencies
    # ══════════════════════════════════════════════════════════════════════════

    # ── 1. ACMG criteria heatmap ──────────────────────────────────────────────
    def _build_acmg_heatmap(df, max_fusions=40):
        CODE_ORDER = [
            "PVS1", "PS1", "PM1", "PM_INFRAME", "PM_INFRAME_NOHI",
            "PM_ONCOGENE", "PP3", "PP_WEAK_HI",
            "BP_OOF", "BP4", "BP7", "BP_AR", "BS1", "BS_TSG_OOF",
        ]
        CODE_WEIGHTS = {
            "PVS1": +8, "PS1": +6, "PM1": +2, "PM_INFRAME": +2,
            "PM_INFRAME_NOHI": +4, "PM_ONCOGENE": +2, "PP3": +1, "PP_WEAK_HI": +1,
            "BP_OOF": -2, "BP4": -1, "BP7": -1, "BP_AR": -1,
            "BS1": -4, "BS_TSG_OOF": -2,
        }
        PATH_COLORS = {
            "Pathogenic":             "#c0392b",
            "Likely_Pathogenic":      "#e74c3c",
            "Uncertain_Significance": "#4a6080",
            "Likely_Benign":          "#1a6b3a",
            "Benign":                 "#145a32",
        }
        top = df.sort_values("acmg_score", ascending=False).head(max_fusions)
        if top.empty:
            return ""
        n_fus  = len(top)
        n_code = len(CODE_ORDER)
        label_w  = 130
        score_w  = 38
        cell_w   = 36
        cell_h   = 22
        header_h = 72
        pad_b    = 10
        W = label_w + n_code * cell_w + score_w + 4
        H = header_h + n_fus * cell_h + pad_b
        import html as _h
        parts = [
            f'<svg viewBox="0 0 {W} {H}" xmlns="http://www.w3.org/2000/svg" '
            f'style="width:100%;max-width:{W}px;font-family:monospace">'
        ]
        for j, code in enumerate(CODE_ORDER):
            cx  = label_w + j * cell_w + cell_w / 2
            cy  = header_h - 6
            w   = CODE_WEIGHTS.get(code, 0)
            col = "#27ae60" if w > 0 else "#c0392b"
            parts.append(
                f'<text x="{cx:.1f}" y="{cy:.1f}" '
                f'transform="rotate(-55,{cx:.1f},{cy:.1f})" '
                f'text-anchor="start" font-size="9" fill="{col}" font-weight="600">'
                f'{code}</text>'
            )
            parts.append(
                f'<text x="{cx:.1f}" y="{header_h - 1}" '
                f'text-anchor="middle" font-size="8" fill="{col}" opacity="0.7">'
                f'{w:+d}</text>'
            )
        parts.append(
            f'<text x="{label_w + n_code * cell_w + score_w / 2:.1f}" '
            f'y="{header_h - 6}" text-anchor="middle" font-size="9" fill="#7a8aa0">'
            f'Score</text>'
        )
        mid_pos = label_w + 4 * cell_w
        mid_neg = label_w + 8 * cell_w + 3 * cell_w
        parts.append(
            f'<text x="{mid_pos:.1f}" y="10" text-anchor="middle" '
            f'font-size="8" fill="#27ae60" opacity="0.7" font-weight="700">'
            f'PATHOGENIC CRITERIA</text>'
        )
        parts.append(
            f'<text x="{mid_neg:.1f}" y="10" text-anchor="middle" '
            f'font-size="8" fill="#c0392b" opacity="0.7" font-weight="700">'
            f'BENIGN CRITERIA</text>'
        )
        for i, (_, row) in enumerate(top.iterrows()):
            y        = header_h + i * cell_h
            ga       = str(row["geneA"])
            gb       = str(row["geneB"])
            codes    = set(str(row.get("acmg_codes", "")).split(";"))
            path     = str(row.get("pathogenicity", ""))
            score    = float(row.get("acmg_score", 0))
            row_col  = PATH_COLORS.get(path, "#4a6080")
            lbl      = f"{ga}::{gb}"
            lbl_disp = lbl if len(lbl) <= 17 else lbl[:16] + "…"
            bg = "#161b22" if i % 2 == 0 else "#0d1117"
            parts.append(f'<rect x="0" y="{y}" width="{W}" height="{cell_h}" fill="{bg}"/>')
            parts.append(
                f'<text x="{label_w - 6}" y="{y + cell_h * 0.68:.1f}" '
                f'text-anchor="end" font-size="9" fill="{row_col}" font-weight="700">'
                f'{_h.escape(lbl_disp)}</text>'
            )
            for j, code in enumerate(CODE_ORDER):
                cx  = label_w + j * cell_w
                hit = code in codes
                w   = CODE_WEIGHTS.get(code, 0)
                if hit:
                    fill    = "#1a5c2a" if w > 0 else "#5c1a1a"
                    outline = "#27ae60" if w > 0 else "#c0392b"
                    parts.append(
                        f'<rect x="{cx + 1}" y="{y + 2}" '
                        f'width="{cell_w - 2}" height="{cell_h - 4}" '
                        f'rx="2" fill="{fill}" stroke="{outline}" stroke-width="1">'
                        f'<title>{lbl}: {code} ({w:+d})</title></rect>'
                    )
                    parts.append(
                        f'<text x="{cx + cell_w/2:.1f}" y="{y + cell_h * 0.72:.1f}" '
                        f'text-anchor="middle" font-size="9" fill="{outline}" font-weight="700">✓</text>'
                    )
                else:
                    parts.append(
                        f'<rect x="{cx + 1}" y="{y + 2}" '
                        f'width="{cell_w - 2}" height="{cell_h - 4}" '
                        f'rx="1" fill="none" stroke="#21262d" stroke-width="0.5"/>'
                    )
            scol = "#c0392b" if score >= 6 else "#e67e22" if score >= 0 else "#27ae60"
            sx   = label_w + n_code * cell_w + score_w / 2
            parts.append(
                f'<text x="{sx:.1f}" y="{y + cell_h * 0.68:.1f}" '
                f'text-anchor="middle" font-size="10" fill="{scol}" font-weight="700">'
                f'{score:+g}</text>'
            )
        divider_x = label_w + 8 * cell_w
        parts.append(
            f'<line x1="{divider_x}" y1="{header_h - 10}" '
            f'x2="{divider_x}" y2="{H - pad_b}" '
            f'stroke="#30363d" stroke-width="1.5" stroke-dasharray="3 2"/>'
        )
        parts.append("</svg>")
        return "".join(parts)
    def _build_circos(df):
        CHR_SIZES = {
            "chr1":248956422,"chr2":242193529,"chr3":198295559,"chr4":190214555,
            "chr5":181538259,"chr6":170805979,"chr7":159345973,"chr8":145138636,
            "chr9":138394717,"chr10":133797422,"chr11":135086622,"chr12":133275309,
            "chr13":114364328,"chr14":107043718,"chr15":101991189,"chr16":90338345,
            "chr17":83257441,"chr18":80373285,"chr19":58617616,"chr20":64444167,
            "chr21":46709983,"chr22":50818468,"chrX":156040895,"chrY":57227415,
        }
        CHR_ORDER = [f"chr{i}" for i in range(1,23)] + ["chrX","chrY"]
        CHR_COLORS = {
            "chr1":"#e74c3c","chr2":"#e67e22","chr3":"#f1c40f","chr4":"#2ecc71",
            "chr5":"#1abc9c","chr6":"#3498db","chr7":"#9b59b6","chr8":"#e91e63",
            "chr9":"#ff5722","chr10":"#8bc34a","chr11":"#00bcd4","chr12":"#673ab7",
            "chr13":"#ff9800","chr14":"#4caf50","chr15":"#2196f3","chr16":"#9c27b0",
            "chr17":"#f44336","chr18":"#009688","chr19":"#ffc107","chr20":"#3f51b5",
            "chr21":"#e91e63","chr22":"#cddc39","chrX":"#ff6b6b","chrY":"#4ecdc4",
        }
        import math as _m
        W,H,CX,CY,R_OUT,R_IN,R_ARC = 600,600,300,300,240,210,170
        total_genome = sum(CHR_SIZES.get(c,0) for c in CHR_ORDER)
        GAP_DEG = 0.8
        total_gap = GAP_DEG * len(CHR_ORDER)
        avail = 360 - total_gap

        # compute arc angles for each chr
        chr_angles = {}
        angle = -90.0
        for ch in CHR_ORDER:
            sz = CHR_SIZES.get(ch, 0)
            span = (sz / total_genome) * avail
            chr_angles[ch] = (angle, angle + span)
            angle += span + GAP_DEG

        def genome_to_angle(chrom, pos):
            ch = "chr" + chrom.lstrip("chr") if not chrom.startswith("chr") else chrom
            if ch not in chr_angles:
                return None
            a0, a1 = chr_angles[ch]
            sz = CHR_SIZES.get(ch, 1)
            return a0 + (pos / sz) * (a1 - a0)

        def pol(r, deg):
            rad = _m.radians(deg)
            return CX + r*_m.cos(rad), CY + r*_m.sin(rad)

        parts = [f'<svg viewBox="0 0 {W} {H}" xmlns="http://www.w3.org/2000/svg" '
                 f'style="width:100%;max-width:{W}px;background:#0d1117">']

        # Draw chromosome arcs
        for ch in CHR_ORDER:
            a0, a1 = chr_angles[ch]
            col = CHR_COLORS.get(ch, "#555")
            large = 1 if (a1-a0) > 180 else 0
            x0o,y0o = pol(R_OUT, a0); x1o,y1o = pol(R_OUT, a1)
            x1i,y1i = pol(R_IN, a1);  x0i,y0i = pol(R_IN, a0)
            d = (f"M {x0o:.1f},{y0o:.1f} A {R_OUT},{R_OUT} 0 {large} 1 {x1o:.1f},{y1o:.1f} "
                 f"L {x1i:.1f},{y1i:.1f} A {R_IN},{R_IN} 0 {large} 0 {x0i:.1f},{y0i:.1f} Z")
            mid = (a0+a1)/2
            mx,my = pol(R_OUT+14, mid)
            label = ch.replace("chr","")
            parts.append(f'<path d="{d}" fill="{col}" opacity="0.7"/>')
            parts.append(f'<text x="{mx:.1f}" y="{my:.1f}" text-anchor="middle" '
                         f'font-size="8" font-family="monospace" fill="#c9d1d9" '
                         f'dominant-baseline="middle">{label}</text>')

        # Draw fusion arcs
        path_arc_colors = {
            "Pathogenic":"#c0392b","Likely_Pathogenic":"#e74c3c",
            "Uncertain_Significance":"#4a9eff","Likely_Benign":"#27ae60","Benign":"#1a6b3a",
        }
        for _, row in df.iterrows():
            try:
                chrA = str(row.get("chrA","") or row.get("break1_chromosome",""))
                chrB = str(row.get("chrB","") or row.get("break2_chromosome",""))
                posA = int(float(str(row.get("startA","0") or row.get("break1_position_start","0") or 0)))
                posB = int(float(str(row.get("startB","0") or row.get("break2_position_start","0") or 0)))
            except Exception:
                continue
            angA = genome_to_angle(chrA, posA)
            angB = genome_to_angle(chrB, posB)
            if angA is None or angB is None:
                continue
            ax,ay = pol(R_IN, angA)
            bx,by = pol(R_IN, angB)
            col = path_arc_colors.get(str(row.get("pathogenicity","")),"#4a9eff")
            # cubic bezier through centre
            parts.append(f'<path d="M {ax:.1f},{ay:.1f} Q {CX},{CY} {bx:.1f},{by:.1f}" '
                         f'fill="none" stroke="{col}" stroke-width="0.8" opacity="0.5"/>')

        # Centre label
        parts.append(f'<text x="{CX}" y="{CY-8}" text-anchor="middle" '
                     f'font-size="13" font-family="monospace" fill="#c9d1d9" font-weight="bold">'
                     f'{len(df)}</text>')
        parts.append(f'<text x="{CX}" y="{CY+10}" text-anchor="middle" '
                     f'font-size="9" font-family="monospace" fill="#7a8aa0">fusions</text>')
        parts.append("</svg>")
        return "".join(parts)

    acmg_heatmap_svg = _build_acmg_heatmap(summary)

    # ── 2. Fusion network graph (force layout in JS) ───────────────────────────
    def _build_network_data(df):
        from collections import defaultdict as _dd
        nodes, edges = {}, []
        path_colors = {
            "Pathogenic":"#c0392b","Likely_Pathogenic":"#e74c3c",
            "Uncertain_Significance":"#4a9eff","Likely_Benign":"#27ae60","Benign":"#1a6b3a",
        }
        gene_count = _dd(int)
        for _, row in df.iterrows():
            ga,gb = str(row["geneA"]), str(row["geneB"])
            gene_count[ga] += 1; gene_count[gb] += 1
        for g,c in gene_count.items():
            nodes[g] = {"id":g,"count":c}
        for _, row in df.iterrows():
            ga,gb = str(row["geneA"]), str(row["geneB"])
            col = path_colors.get(str(row.get("pathogenicity","")),"#4a9eff")
            edges.append({"source":ga,"target":gb,"color":col,
                          "path":str(row.get("pathogenicity","")),
                          "acmg":float(row.get("acmg_score",0))})
        import json as _json
        return (_json.dumps(list(nodes.values())),
                _json.dumps(edges))

    net_nodes_json, net_edges_json = _build_network_data(summary)

    # ── 3. ACMG score breakdown bar per fusion (for cards) ────────────────────
    def _acmg_bar(codes_str, score):
        CODE_SCORES = {
            "PVS1":8,"PS1":6,"PM1":2,"PM_INFRAME":2,"PM_INFRAME_NOHI":4,
            "PM_ONCOGENE":2,"PP3":1,"PP_WEAK_HI":1,
            "BP_OOF":-2,"BP4":-1,"BP7":-1,"BP_AR":-1,"BS1":-4,"BS_TSG_OOF":-2,
        }
        codes = [c.strip() for c in str(codes_str).split(";") if c.strip() and c != "."]
        if not codes:
            return ""
        pos_total = sum(max(0, CODE_SCORES.get(c, 0)) for c in codes)
        neg_total = abs(sum(min(0, CODE_SCORES.get(c, 0)) for c in codes))
        total_span = max(pos_total + neg_total, 1)
        W = 240
        parts = [f'<svg viewBox="0 0 {W} 28" xmlns="http://www.w3.org/2000/svg" '
                 f'style="width:100%;max-width:{W}px">']
        x = 0
        for c in codes:
            v = CODE_SCORES.get(c, 0)
            if v == 0: continue
            bw = abs(v) / total_span * W
            col = "#27ae60" if v > 0 else "#c0392b"
            parts.append(f'<rect x="{x:.1f}" y="4" width="{bw:.1f}" height="14" '
                         f'rx="2" fill="{col}" opacity="0.8">'
                         f'<title>{c}: {v:+d}</title></rect>')
            if bw > 22:
                parts.append(f'<text x="{x+bw/2:.1f}" y="15" text-anchor="middle" '
                              f'font-size="8" font-family="monospace" fill="white">{c}</text>')
            x += bw
        try:
            score_f = float(score)
        except (ValueError, TypeError):
            score_f = 0.0
        scol = "#c0392b" if score_f >= 6 else "#e67e22" if score_f >= 0 else "#27ae60"
        parts.append(f'<text x="{W}" y="24" text-anchor="end" '
                     f'font-size="9" font-family="monospace" fill="{scol}">total: {score_f:+g}</text>')
        parts.append("</svg>")
        return "".join(parts)

    # ── 5. Run metadata ───────────────────────────────────────────────────────
    import json as _json
    run_meta_rows = "".join([
        f'<tr><td class="rmk">{_html.escape(k)}</td><td class="rmv">{_html.escape(str(v))}</td></tr>'
        for k, v in [
            ("Input SV file",         str(sv_file) if sv_file else "—"),
