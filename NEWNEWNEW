def write_bed(summary, edge_events, out_file):
    """
    Write a BED file of all fusion breakpoints for loading into IGV or UCSC.

    Each fusion produces two BED entries (one per breakpoint), with the
    fusion name and ACMG score in the name column and colour-coded by
    pathogenicity class so they are immediately visually distinct in IGV.
    """
    PATH_BED_COLORS = {
        "Pathogenic":             "192,0,0",
        "Likely_Pathogenic":      "224,64,0",
        "Uncertain_Significance": "128,128,128",
        "Likely_Benign":          "39,174,96",
        "Benign":                 "26,107,58",
    }
    lines = [
        'track name="Chimera Fusion Breakpoints" '
        'description="Chimera fusion gene breakpoints" '
        'visibility=2 itemRgb="On" useScore=0'
    ]
    for _, row in summary.iterrows():
        key    = (row["geneA"], row["geneB"])
        events = edge_events.get(key, [])
        if not events:
            continue
        event  = events[0]
        path   = str(row.get("pathogenicity", "Uncertain_Significance"))
        rgb    = PATH_BED_COLORS.get(path, "128,128,128")
        name   = f"{row['geneA']}::{row['geneB']}"
        score  = int(min(1000, max(0, (float(row.get("acmg_score", 0)) + 10) * 50)))

        for side, chrom_key, start_key, end_key in [
            ("BP1", "chrA", "startA", "endA"),
            ("BP2", "chrB", "startB", "endB"),
        ]:
            chrom = norm_chr(str(event.get(chrom_key, "chrUn")))
            start = int(event.get(start_key, 0))
            end   = max(int(event.get(end_key, start + 1)), start + 1)
            lines.append(
                f"{chrom}\t{start}\t{end}\t{name}_{side}\t{score}"
                f"\t.\t{start}\t{end}\t{rgb}"
            )
    Path(out_file).write_text("\n".join(lines) + "\n", encoding="utf-8")
    return Path(out_file)


def write_igv_session(summary, edge_events, bed_file, out_file, genome="hg38"):
    """
    Write an IGV session XML file that pre-loads the BED track and sets
    the initial locus to the highest-priority fusion.

    Open with: File → Open Session in IGV, or igv.sh --genome hg38 session.xml
    Also works as a UCSC custom track if the BED file is hosted publicly.
    """
    # Pick the top fusion (highest ACMG score) as the opening locus
    locus = "All"
    if not summary.empty:
        top = summary.iloc[0]
        key = (top["geneA"], top["geneB"])
        events = edge_events.get(key, [])
        if events:
            ev = events[0]
            chrom = norm_chr(str(ev.get("chrA", "chr1")))
            start = max(0, int(ev.get("startA", 0)) - 50000)
            end   = int(ev.get("endA", start + 100000)) + 50000
            locus = f"{chrom}:{start}-{end}"

    bed_abs = Path(bed_file).resolve()
    session = f"""<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Session genome="{genome}" hasGeneTrack="true" hasSequenceTrack="true"
         locus="{locus}" version="8">
    <Resources>
        <Resource path="{bed_abs}"/>
    </Resources>
    <Panel height="200" name="FeaturePanel" width="1500">
        <Track attributeKey="{bed_abs.name}" clazz="org.broad.igv.track.FeatureTrack"
               color="0,0,178" colorScale="ContinuousColorScale;0.0;160.0;255,255,255;0,0,178"
               fontSize="14" id="{bed_abs}" name="Chimera Fusion Breakpoints"
               renderer="BASIC_FEATURE" sortable="false" visible="true"
               windowFunction="count">
        </Track>
    </Panel>
    <HiddenAttributes>
        <Attribute name="DATA FILE"/>
        <Attribute name="DATA TYPE"/>
        <Attribute name="NAME"/>
    </HiddenAttributes>
</Session>"""
    Path(out_file).write_text(session, encoding="utf-8")
    return Path(out_file)


