def parse_args():
    script_dir  = Path(__file__).resolve().parent
    project_dir = script_dir.parent
    parser = argparse.ArgumentParser(
        description=(
            "Call candidate gene fusions from structural variants "
            "and draw SVG annotations."
        )
    )
    parser.add_argument(
        "--sv-file",
        default=project_dir / "Book2.clean.tsv", type=Path,
    )
    parser.add_argument(
        "--gene-file",
        default=project_dir / "annotation" / "genes.bed", type=Path,
    )
    parser.add_argument(
        "--gencode-file", "--gff3-file", dest="gencode_file",
        default=project_dir / "annotation" / "gencode.v47.annotation.gtf.gz",
        type=Path,
        help="Optional GENCODE GTF/GFF3 file, optionally .gz.",
    )
    parser.add_argument(
        "--out-file",
        default=project_dir / "results" / "tables" / "fusion_final.txt", type=Path,
    )
    parser.add_argument(
        "--variants-out",
        default=project_dir / "results" / "tables" / "variants_processed.tsv", type=Path,
    )
    parser.add_argument(
        "--breakpoints-out",
        default=project_dir / "results" / "tables" / "breakpoint_annotations.tsv", type=Path,
    )
    parser.add_argument(
        "--svg-dir",
        default=project_dir / "results" / "svg", type=Path,
        help="Directory for SVG fusion diagrams (default: results/svg/).",
    )
    parser.add_argument("--max-svgs", default=500, type=int,
                        help="Max SVG diagrams to generate (default: 500).")
    parser.add_argument(
        "--svg-width", default=1200, type=int,
        help="Width of output SVG files in pixels (default: 1200).",
    )
    parser.add_argument(
        "--clingen-file",
        default=project_dir / "annotation" / "tableExport-2.csv",
        type=Path,
        help="ClinGen dosage sensitivity file (FTP TSV or browser CSV export).",
    )
    parser.add_argument(
        "--cosmic-file",
        default=project_dir / "annotation" / "cancer_gene_census.csv",
        type=Path,
        help="COSMIC Cancer Gene Census TSV/CSV (optional; enables oncogene/TSG evidence).",
    )
    parser.add_argument(
        "--min-sv-score", default=0.0, type=float,
        help="Minimum support_score to include a fusion in output (default: 0 = all).",
    )
    parser.add_argument(
        "--min-fusion-distance", default=MIN_FUSION_DISTANCE, type=int,
        help=(
            f"Minimum bp distance for intrachromosomal fusions "
            f"(default: {MIN_FUSION_DISTANCE}). Events closer than this are "
            f"written to --short-sv-out and excluded from the main summary."
        ),
    )
    parser.add_argument(
        "--intragenic-out",
        default=project_dir / "results" / "tables" / "intragenic_events.tsv", type=Path,
        help="Output file for same-gene (intragenic) breakpoint events.",
    )
    parser.add_argument(
        "--short-sv-out",
        default=project_dir / "results" / "tables" / "short_sv_events.tsv", type=Path,
        help="Output file for intrachromosomal events below --min-fusion-distance.",
    )
    parser.add_argument(
        "--html-index",
        default=project_dir / "results" / "report" / "index.html",
        type=Path,
        help="Path for the unified HTML report (cohort summary + fusion diagrams).",
    )
    parser.add_argument(
        "--debug-genes", nargs="*", default=None, metavar="GENE",
        help=(
            "Print CDS lookup diagnostics for these gene symbols to help "
            "diagnose wrong reading frame calls. "
            "Example: --debug-genes ABL1 BCR"
        ),
    )
    parser.add_argument(
        "--cohort-report",
        default=project_dir / "results" / "report" / "cohort_summary.html",
        type=Path, metavar="PATH",
        help="Kept for backwards compatibility — output is now merged into --html-index.",
    )
    parser.add_argument(
        "--bed-out",
        default=project_dir / "results" / "annotations" / "fusion_breakpoints.bed",
        type=Path, metavar="PATH",
        help="BED file of all fusion breakpoints for IGV / UCSC (default: results/annotations/).",
    )
    parser.add_argument(
        "--igv-session",
        default=project_dir / "results" / "annotations" / "chimera_igv_session.xml",
        type=Path, metavar="PATH",
        help="IGV session XML file (default: results/annotations/). Double-click to open in IGV.",
    )
    parser.add_argument(
        "--genome", default="hg38",
        help="Reference genome for the IGV session file (default: hg38).",
    )
    return parser.parse_args()


def main():
    args = parse_args()

    # Create all output subdirectories up front
    for p in [
        args.out_file.parent,         # results/tables/
        args.html_index.parent,        # results/report/
        args.svg_dir,                  # results/svg/
        args.bed_out.parent,           # results/annotations/
    ]:
        p.mkdir(parents=True, exist_ok=True)

    gencode_file = args.gencode_file if args.gencode_file.exists() else None
    gene_index, gene_lookup, _, exon_index = read_gene_annotations(
        args.gene_file, gencode_file
    )
    print("Gene annotation source:",
          gencode_file if gencode_file else args.gene_file)
    print("Exon records indexed:",
          sum(len(v) for v in exon_index.values()))

    sv, bad_rows = load_svs(args.sv_file)
    sv.to_csv(args.variants_out, sep="\t", index=False)
    print("SV rows loaded:",  len(sv))
    print("SV rows skipped:", bad_rows)
    print("Processed variants written to:", args.variants_out)

    (edge_counts, edge_svtypes, edge_events,
     breakpoint_annotations, intragenic_events, short_sv_events,
     debug_hits) = collect_fusions(sv, gene_index, args.min_fusion_distance)

    breakpoint_annotations.to_csv(args.breakpoints_out, sep="\t", index=False)
    print("SVs hitting genes on BOTH sides:", debug_hits)
    print("Breakpoint annotations written to:", args.breakpoints_out)

    # Item 2: write intragenic events
    if not intragenic_events.empty:
        intragenic_events.to_csv(args.intragenic_out, sep="\t", index=False)
        print(f"Intragenic events (same-gene): {len(intragenic_events)} "
              f"→ {args.intragenic_out}")
    else:
        print("Intragenic events: none")

    # Item 3: write short-distance SV events
    if not short_sv_events.empty:
        short_sv_events.to_csv(args.short_sv_out, sep="\t", index=False)
        print(f"Short-distance SV events (<{args.min_fusion_distance}bp): "
              f"{len(short_sv_events)} → {args.short_sv_out}")
    else:
        print(f"Short-distance SV events (<{args.min_fusion_distance}bp): none")

    hi_genes, ts_genes = {}, {}
    if args.clingen_file.exists():
        try:
            hi_genes, ts_genes = load_clingen_dosage(args.clingen_file)
            print(f"ClinGen HI genes loaded: {len(hi_genes)}")
            print(f"ClinGen TS genes loaded: {len(ts_genes)}")
        except Exception as exc:
            print(
                f"Warning: ClinGen file could not be loaded ({exc})"
                " — pathogenicity set to Uncertain_Significance"
            )
    else:
        print(
            f"ClinGen file not found at {args.clingen_file}"
            " — pathogenicity will be Uncertain_Significance"
        )

    oncogenes, tsgs = load_cancer_genes(args.cosmic_file)
    # Fix 3: always print loaded counts so missing COSMIC is immediately visible
    if not oncogenes and not tsgs:
        print("WARNING: No COSMIC cancer genes loaded — PM_ONCOGENE/BS_TSG_OOF "
              "criteria will not fire. Check --cosmic-file path and column names.")

    debug_genes = set(args.debug_genes) if args.debug_genes else None

    summary = build_summary(
        edge_counts, edge_svtypes, edge_events, exon_index,
        hi_genes, ts_genes, oncogenes, tsgs,
        min_support_score=args.min_sv_score,
        debug_genes=debug_genes,
    )
    summary.to_csv(args.out_file, sep="\t", index=False)
    print(f"Fusions in summary: {len(summary)}")

    svg_files = write_svgs(
        summary, edge_events, gene_lookup, exon_index,
        args.svg_dir, args.max_svgs, svg_width=args.svg_width,
    )

    index_file = None
    if svg_files or not summary.empty:
        index_file = write_html_index(
            summary, args.svg_dir, args.html_index,
            variants_df=sv,
            breakpoints_df=breakpoint_annotations,
            intragenic_df=intragenic_events if not intragenic_events.empty else None,
            short_sv_df=short_sv_events if not short_sv_events.empty else None,
            bed_file=args.bed_out,
            igv_file=args.igv_session,
            sv_file=args.sv_file,
            genome=args.genome,
        )

    n_embedded = sum(
        1 for _, row in summary.iterrows()
        if (args.svg_dir.resolve() /
            f"{slug(row['geneA'])}_{slug(row['geneB'])}_fusion.svg").exists()
    ) if index_file else 0

    bed_file     = write_bed(summary, edge_events, args.bed_out)
    session_file = write_igv_session(
        summary, edge_events, bed_file, args.igv_session, genome=args.genome
    )

    # ── Clean output summary ──────────────────────────────────────────────────
    res = args.out_file.parent.parent   # results/
    print(f"""
Chimera complete — {len(summary)} fusions called
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
{res}/
 ├── tables/
 │   ├── fusion_final.txt              ({len(summary)} fusions)
 │   ├── variants_processed.tsv
 │   ├── breakpoint_annotations.tsv
 │   ├── intragenic_events.tsv
 │   └── short_sv_events.tsv
 ├── report/
 │   └── index.html                    (open in browser — {n_embedded} SVGs embedded)
 ├── svg/
 │   └── *.svg                         ({len(svg_files)} diagrams)
 └── annotations/
     ├── fusion_breakpoints.bed        (load into IGV or UCSC)
     └── chimera_igv_session.xml       (File → Open Session in IGV)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━""")


if __name__ == "__main__":
    main()
