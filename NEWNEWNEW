<script>
// Position tab bar below header dynamically — runs before content paints
document.addEventListener('DOMContentLoaded', function() {{
  function layout() {{
    var h  = document.querySelector('header');
    var tb = document.querySelector('.tab-bar');
    if (!h || !tb) return;
    var hh = h.offsetHeight;
    tb.style.top = hh + 'px';
    document.body.style.paddingTop = (hh + tb.offsetHeight) + 'px';
  }}
  layout();
  window.addEventListener('resize', layout);
}});

// Fallback controls. These are intentionally defined before the report body so
// navigation still works even if a later visualisation script hits bad data.
window.toggleRunDetails = function() {{
  const el = document.getElementById('meta-detail');
  if (el) el.classList.toggle('hidden');
}};

window.showTab = function(name) {{
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  const tab = document.getElementById('tab-' + name);
  const panel = document.getElementById('panel-' + name);
  if (tab) tab.classList.add('active');
  if (panel) panel.classList.add('active');
  if (name === 'visual' && typeof window.initNetwork === 'function') window.initNetwork();
}};

window.toggleCard = function(id) {{
  const body = document.getElementById('body_' + id);
  const chev = document.getElementById('chev_' + id);
  if (body) body.classList.toggle('open');
  if (chev) chev.classList.toggle('open');
}};

window.filterCards = function(pathClass) {{
  document.querySelectorAll('.fbtn').forEach(b => b.classList.remove('active'));
  const btn = [...document.querySelectorAll('.fbtn')]
    .find(b => b.textContent.trim().replace(/ /g,'_') === pathClass ||
               (pathClass === 'all' && b.textContent.trim() === 'All'));
  if (btn) btn.classList.add('active');
  let shown = 0;
  document.querySelectorAll('.card').forEach(card => {{
    const match = pathClass === 'all' || card.dataset.path === pathClass;
    card.classList.toggle('hidden', !match);
    if (match) shown++;
  }});
  const label = document.getElementById('count-label');
  if (label) label.textContent = shown + ' fusion' + (shown !== 1 ? 's' : '') + ' shown';
}};

window.filterTable = function(tableId, query) {{
  const tbl = document.getElementById(tableId);
  if (!tbl) return;
  const q = String(query || '').toLowerCase();
  tbl.querySelectorAll('tbody tr').forEach(row => {{
    row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
  }});
}};

window.sortTable = function(tableId, colIdx) {{
  const tbl = document.getElementById(tableId);
  if (!tbl) return;
  const tbody = tbl.querySelector('tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));
  const asc = !(tbl.dataset.sortCol == colIdx && tbl.dataset.sortDir === 'asc');
  tbl.dataset.sortCol = colIdx;
  tbl.dataset.sortDir = asc ? 'asc' : 'desc';
  rows.sort((a, b) => {{
    const va = a.cells[colIdx]?.textContent.trim() ?? '';
    const vb = b.cells[colIdx]?.textContent.trim() ?? '';
    const na = parseFloat(va), nb = parseFloat(vb);
    const cmp = (!isNaN(na) && !isNaN(nb)) ? na - nb : va.localeCompare(vb);
    return asc ? cmp : -cmp;
  }});
  rows.forEach(r => tbody.appendChild(r));
}};

window.downloadTable = function(tableId, filename) {{
  const tbl = document.getElementById(tableId);
  if (!tbl) return;
  const rows = [];
  tbl.querySelectorAll('tr').forEach(tr => {{
    if (tr.style.display === 'none') return;
    const cells = Array.from(tr.querySelectorAll('th,td'))
      .map(c => c.textContent.replace(/\t/g,' ').trim());
    rows.push(cells.join('\t'));
  }});
  const blob = new Blob([rows.join('\\n')], {{type:'text/tab-separated-values'}});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  a.click();
  URL.revokeObjectURL(a.href);
}};

window.showFusion = function(cardId) {{
  window.showTab('fusions');
  setTimeout(() => {{
    const el = document.getElementById(cardId);
    if (!el) return;
    el.scrollIntoView({{behavior:'smooth', block:'start'}});
    window.toggleCard(cardId);
  }}, 80);
}};
</script>

