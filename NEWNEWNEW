def _truncate_svg_text(text, max_chars):
    """Truncate text for SVG display, appending ellipsis if needed."""
    text = str(text)
    return text if len(text) <= max_chars else text[:max_chars - 1] + "…"


def interval_for_gene(gene_lookup, gene, fallback_chrom, fallback_start, fallback_end):
    intervals = gene_lookup.get(gene, [])
    if intervals:
        return intervals[0]
    start, end = sorted([fallback_start, fallback_end])
    return fallback_chrom, max(1, start - WINDOW), end + WINDOW, "."


def marker_x(pos, start, end, x, width):
    if end <= start:
        return x + width / 2
    pos = min(max(pos, start), end)
    return x + ((pos - start) / (end - start)) * width


def svg_text(text, x, y, size=16, weight="normal", anchor="middle", fill="#111111"):
    return (
        f'<text x="{x:.1f}" y="{y:.1f}" text-anchor="{anchor}" '
        f'font-size="{size}" font-weight="{weight}" fill="{fill}" '
        'font-family="Consolas, Courier New, monospace">'
        f"{html.escape(str(text))}</text>"
    )


def svg_badge(text, x, y, fill, stroke="#111111"):
    text  = str(text)
    width = max(150, len(text) * 9 + 28)
    left  = x - width / 2
    return "\n".join([
        f'<rect x="{left:.1f}" y="{y:.1f}" width="{width:.1f}" height="30" rx="4"'
        f' fill="{fill}" stroke="{stroke}" stroke-width="1"/>',
        svg_text(text, x, y + 21, size=14, weight="bold", fill="#ffffff"),
    ])


def display_fusion_class(fusion_class):
    text = str(fusion_class)
    if "CANONICAL" in text and "NON_CANONICAL" not in text:
        return "CANONICAL FUSION", "#2f7d4f"
    if "NON_CANONICAL" in text:
        return "NON-CANONICAL FUSION", "#b35c1e"
    if "UNKNOWN" in text:
        return "UNKNOWN", "#666666"
    return text.replace("_", " "), "#666666"


def gene_label(gene, strand):
    return f"{gene} ({strand})" if strand in {"+", "-"} else str(gene)


