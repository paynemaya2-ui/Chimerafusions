        f'<tr><td class="gene-name">{_html.escape(str(g))}</td>'
        f'<td class="gene-count">{c}</td>'
        f'<td style="width:200px;vertical-align:middle;padding:6px 14px">'
        f'<div style="height:10px;width:{max(2, int(c/max_gc*100))}%;background:#4a9eff;'
        f'border-radius:2px;opacity:.7;min-width:4px"></div></td></tr>'
        for g, c in s["top_genes"]
    )

    callout_html = (
        f'<div class="callout alert">&#9888; {n_path} Pathogenic/Likely Pathogenic '
        f'fusion(s) detected — click any row in the Priority Fusions table to jump to it.</div>'
        if n_path > 0
        else '<div class="callout">No Pathogenic or Likely Pathogenic fusions detected.</div>'
    )

    callout_html = (
        f'<div class="callout alert">&#9888; {n_path} Pathogenic/Likely Pathogenic '
        f'fusion(s) detected — click any row in the Priority Fusions table to jump to it.</div>'
        if n_path > 0
        else '<div class="callout">No Pathogenic or Likely Pathogenic fusions detected.</div>'
