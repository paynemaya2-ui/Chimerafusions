def _rpt_compute_stats(df):
    inter = df[df["geneA"] != df["geneB"]].copy()
    intra = df[df["geneA"] == df["geneB"]].copy()
    path_all   = defaultdict(int, {k: v for k, v in
                  zip(*zip(*[(r, 1) for r in df["pathogenicity"]])) if True}
                 ) if False else defaultdict(int)
    # simpler:
    for v in df["pathogenicity"]:   path_all[v] += 1
    path_inter = defaultdict(int)
    for v in inter["pathogenicity"]: path_inter[v] += 1
    fclass = defaultdict(int)
    for v in inter["fusion_class"]:  fclass[v] += 1
    frame_inter = defaultdict(int)
    for v in inter["reading_frame"]: frame_inter[v] += 1
    mech_inter = defaultdict(int)
    for v in inter["mechanism"]:     mech_inter[v] += 1
    sv_types = defaultdict(int)
    for vs in df["svtypes"].str.split(";"):
        for v in vs:
            sv_types[v.strip()] += 1
    acmg_codes = defaultdict(int)
    for vs in df["acmg_codes"].str.split(";"):
        for v in vs:
            c = v.strip()
            if c and c != ".":
                acmg_codes[c] += 1
    all_genes = list(df["geneA"]) + list(df["geneB"])
    gene_counter = defaultdict(int)
    for g in all_genes:
        gene_counter[g] += 1
    top_genes = sorted(gene_counter.items(), key=lambda x: -x[1])[:20]
    inter_sorted = inter.sort_values("acmg_score", ascending=False)
    cols = ["geneA", "geneB", "acmg_score", "pathogenicity",
            "reading_frame", "mechanism", "acmg_codes",
            "pathogenicity_evidence", "variant_ids"]
    top_fusions = inter_sorted.head(10)[cols].to_dict("records")
    score_buckets = defaultdict(int)
    for s in df["acmg_score"]:
        if s >= 10:    score_buckets[">=10 (Pathogenic)"] += 1
        elif s >= 6:   score_buckets["6-9 (Likely Path.)"] += 1
        elif s >= -5:  score_buckets["-5 to 5 (VUS)"] += 1
        elif s >= -9:  score_buckets["-6 to -9 (Likely Benign)"] += 1
        else:          score_buckets["<=-10 (Benign)"] += 1
    uid_set = set()
    for vs in df["variant_ids"].str.split(";"):
        uid_set.update(vs)
    return dict(
        n_total=len(df), n_inter=len(inter), n_intra=len(intra),
        path_all=dict(path_all), path_inter=dict(path_inter),
        fclass=dict(fclass), frame_inter=dict(frame_inter),
        mech_inter=dict(mech_inter), sv_types=dict(sv_types),
        acmg_codes=dict(acmg_codes), top_genes=top_genes,
        top_fusions=top_fusions, score_buckets=dict(score_buckets),
        acmg_scores=df["acmg_score"].tolist(),
        n_unique_variants=len(uid_set),
    )


def _rpt_svg_pie(data, colors, width=220, height=220):
    cx, cy, r_out, r_in = width / 2, height / 2, 88, 52
    total = sum(data.values()) or 1
    def polar(r, a):
        rad = _math.radians(a - 90)
        return cx + r * _math.cos(rad), cy + r * _math.sin(rad)
    parts, angle = [], 0
    for key, val in data.items():
        if not val:
            continue
        frac = val / total
        sweep = frac * 360
        large = 1 if sweep > 180 else 0
        x1o, y1o = polar(r_out, angle)
        x2o, y2o = polar(r_out, angle + sweep)
        x1i, y1i = polar(r_in,  angle + sweep)
        x2i, y2i = polar(r_in,  angle)
        c = colors.get(key, "#999")
        pct = frac * 100
        d = (f"M {x1o:.1f} {y1o:.1f} A {r_out} {r_out} 0 {large} 1 "
             f"{x2o:.1f} {y2o:.1f} L {x1i:.1f} {y1i:.1f} "
             f"A {r_in} {r_in} 0 {large} 0 {x2i:.1f} {y2i:.1f} Z")
        title = _html.escape(f"{key}: {val} ({pct:.1f}%)")
        parts.append(f'<path d="{d}" fill="{c}" stroke="#1a1a2e" stroke-width="1.5">'
                     f'<title>{title}</title></path>')
        if pct > 6:
            mx, my = polar((r_out + r_in) / 2, angle + sweep / 2)
            parts.append(f'<text x="{mx:.1f}" y="{my+4:.1f}" text-anchor="middle" '
                         f'font-size="11" font-family="monospace" fill="white" '
                         f'font-weight="bold">{pct:.0f}%</text>')
        angle += sweep
    inner = "".join(parts)
    return (f'<svg viewBox="0 0 {width} {height}" '
            f'xmlns="http://www.w3.org/2000/svg" '
            f'style="width:100%;max-width:{width}px">{inner}</svg>')


def _rpt_svg_bar_h(data, colors, width=340):
    if not data:
        return ""
    items = sorted(data.items(), key=lambda x: -x[1])
    max_val = max(v for _, v in items) or 1
    total   = sum(v for _, v in items) or 1
    bar_h, gap, label_w = 22, 6, 160
    chart_w = width - label_w - 10
    h = len(items) * (bar_h + gap) + 20
    parts = [f'<svg viewBox="0 0 {width} {h}" xmlns="http://www.w3.org/2000/svg" '
             f'style="width:100%;max-width:{width}px">']
    for i, (key, val) in enumerate(items):
        y     = 5 + i * (bar_h + gap)
        bw    = (val / max_val) * chart_w
        c     = colors.get(key, "#4a9eff")
        label = key.replace("_FUSION", "").replace("_", " ")
        pct   = val / total * 100
        parts.append(
            f'<text x="{label_w - 6}" y="{y + bar_h * 0.72:.1f}" '
            f'text-anchor="end" font-size="11" font-family="monospace" fill="#b0b8c8">'
            f'{_html.escape(label)}</text>'
            f'<rect x="{label_w}" y="{y}" width="{bw:.1f}" height="{bar_h}" '
            f'rx="2" fill="{c}" opacity="0.9">'
            f'<title>{_html.escape(key)}: {val} ({pct:.1f}%)</title></rect>'
            f'<text x="{label_w + bw + 4}" y="{y + bar_h * 0.72:.1f}" '
            f'font-size="10" font-family="monospace" fill="#7a8aa0">'
            f'{val} ({pct:.0f}%)</text>'
        )
    parts.append("</svg>")
    return "".join(parts)


def _rpt_svg_histogram(scores, width=380, height=150):
    if not scores:
        return ""
    min_s, max_s, n_bins = -10, 10, 20
    bw_val = (max_s - min_s) / n_bins
    bins = [0] * n_bins
    for s in scores:
        idx = max(0, min(n_bins - 1, int((s - min_s) / bw_val)))
        bins[idx] += 1
    max_bin = max(bins) or 1
    pad_l, pad_r, pad_t, pad_b = 28, 10, 10, 22
    chart_w = width - pad_l - pad_r
    chart_h = height - pad_t - pad_b
    bar_w   = chart_w / n_bins
    zero_x  = pad_l + (0 - min_s) / (max_s - min_s) * chart_w
    parts = [
        f'<svg viewBox="0 0 {width} {height}" xmlns="http://www.w3.org/2000/svg" '
        f'style="width:100%;max-width:{width}px">',
        # baseline
        f'<line x1="{pad_l}" y1="{pad_t + chart_h}" '
        f'x2="{pad_l + chart_w}" y2="{pad_t + chart_h}" '
        f'stroke="#30363d" stroke-width="1"/>',
        # zero dashed line
        f'<line x1="{zero_x:.1f}" y1="{pad_t}" '
        f'x2="{zero_x:.1f}" y2="{pad_t + chart_h}" '
        f'stroke="#4a9eff" stroke-width="1" stroke-dasharray="3 2" opacity="0.6"/>',
    ]
    for i, count in enumerate(bins):
        if count == 0:
            continue
        x   = pad_l + i * bar_w
        bh  = (count / max_bin) * chart_h
        y   = pad_t + chart_h - bh
        mid = min_s + (i + 0.5) * bw_val
        c = (_REPORT_PATH_COLORS["Pathogenic"] if mid >= 6
             else "#e67e22" if mid >= 0
             else _REPORT_PATH_COLORS["Uncertain_Significance"] if mid >= -5
             else _REPORT_PATH_COLORS["Likely_Benign"])
        parts.append(
            f'<rect x="{x:.1f}" y="{y:.1f}" width="{bar_w - 1:.1f}" height="{bh:.1f}" '
            f'rx="1" fill="{c}" opacity="0.9">'
            f'<title>Score {mid:.1f}: {count} fusions</title></rect>'
        )
        if count > 0 and bh > 14:
            parts.append(
                f'<text x="{x + bar_w/2:.1f}" y="{y - 2:.1f}" text-anchor="middle" '
                f'font-size="8" font-family="monospace" fill="#7a8aa0">{count}</text>'
            )
    # x-axis labels
    for lbl in [-10, -5, 0, 5, 10]:
        lx = pad_l + (lbl - min_s) / (max_s - min_s) * chart_w
        col = "#4a9eff" if lbl == 0 else "#7a8aa0"
        parts.append(
            f'<text x="{lx:.1f}" y="{height - 4}" text-anchor="middle" '
            f'font-size="9" font-family="monospace" fill="{col}">{lbl}</text>'
        )
    parts.append("</svg>")
    return "".join(parts)


def _rpt_legend(data, colors):
    total = sum(data.values()) or 1
    items = []
    for key, val in data.items():
        if not val:
            continue
        c   = colors.get(key, "#999")
        pct = val / total * 100
        lbl = key.replace("_", " ")
        items.append(
            f'<div class="legend-item">'
            f'<span class="legend-dot" style="background:{c}"></span>'
            f'<span class="legend-key">{_html.escape(lbl)}</span>'
            f'<span class="legend-val">{val:,} '
            f'<em>({pct:.1f}%)</em></span></div>'
        )
    return '<div class="legend">' + "".join(items) + "</div>"


def generate_cohort_report(summary_df, out_file, source_label="fusion_final.txt"):
    """
    Build a self-contained HTML cohort summary report from the fusion summary
    DataFrame produced by build_summary().  Writes to out_file.
    """
    df = summary_df.copy()
    df["acmg_score"]   = pd.to_numeric(df["acmg_score"],   errors="coerce").fillna(0)
    df["support_score"]= pd.to_numeric(df["support_score"],errors="coerce").fillna(0)

    s        = _rpt_compute_stats(df)
    run_date = _datetime.datetime.now().strftime("%Y-%m-%d %H:%M")

    def pct(n, d):
        return f"{n / d * 100:.1f}%" if d else "0%"

    n_path   = s["path_all"].get("Pathogenic", 0) + s["path_all"].get("Likely_Pathogenic", 0)
    n_vus    = s["path_all"].get("Uncertain_Significance", 0)
    n_benign = s["path_all"].get("Likely_Benign", 0) + s["path_all"].get("Benign", 0)
    n_canon  = (s["fclass"].get("CANONICAL", 0) + s["fclass"].get("HIGH_CONF_CANONICAL", 0))
    n_inframe= s["frame_inter"].get("IN_FRAME", 0)

    pie_path       = _rpt_svg_pie({k: s["path_all"].get(k, 0) for k in _REPORT_PATH_ORDER},
                                  _REPORT_PATH_COLORS)
    pie_path_inter = _rpt_svg_pie({k: s["path_inter"].get(k, 0) for k in _REPORT_PATH_ORDER},
                                  _REPORT_PATH_COLORS)
    pie_frame      = _rpt_svg_pie(dict(s["frame_inter"]), _REPORT_FRAME_COLORS)
    bar_mech       = _rpt_svg_bar_h(dict(s["mech_inter"]), _REPORT_MECH_COLORS)
    sv_colors      = {"DEL": "#2980b9", "DUP": "#e67e22",
                      "INV": "#16a085", "BND": "#8e44ad"}
    bar_sv         = _rpt_svg_bar_h(dict(s["sv_types"]), sv_colors, width=280)
    bar_acmg       = _rpt_svg_bar_h(
        dict(sorted(s["acmg_codes"].items(), key=lambda x: -x[1])[:12]),
        {}, width=400,
    )
    hist = _rpt_svg_histogram(s["acmg_scores"])

    leg_path       = _rpt_legend({k: s["path_all"].get(k, 0) for k in _REPORT_PATH_ORDER},
                                 _REPORT_PATH_COLORS)
    leg_path_inter = _rpt_legend({k: s["path_inter"].get(k, 0) for k in _REPORT_PATH_ORDER},
                                 _REPORT_PATH_COLORS)
    leg_frame      = _rpt_legend(dict(s["frame_inter"]), _REPORT_FRAME_COLORS)
    leg_sv         = _rpt_legend(dict(s["sv_types"]), sv_colors)

    # Score bucket table rows
    bucket_order  = [">=10 (Pathogenic)", "6-9 (Likely Path.)", "-5 to 5 (VUS)",
                     "-6 to -9 (Likely Benign)", "<=-10 (Benign)"]
    bucket_colors_list = ["#c0392b", "#e74c3c", "#7f8c8d", "#27ae60", "#1a6b3a"]
    bucket_rows = []
    for bk, bc in zip(bucket_order, bucket_colors_list):
        n = s["score_buckets"].get(bk, 0)
        bucket_rows.append(
            f'<tr><td><span style="color:{bc};font-weight:700">'
            f'{_html.escape(bk)}</span></td>'
            f'<td class="num">{n:,}</td>'
            f'<td class="num">{pct(n, s["n_total"])}</td></tr>'
        )
    bucket_table = "".join(bucket_rows)

    # Top fusion rows
    top_rows = []
    for f in s["top_fusions"]:
        pc   = _REPORT_PATH_COLORS.get(str(f["pathogenicity"]), "#7f8c8d")
        fc   = _REPORT_FRAME_COLORS.get(str(f["reading_frame"]), "#7f8c8d")
        evid = str(f.get("pathogenicity_evidence", ""))
        evid_short = evid[:120] + ("…" if len(evid) > 120 else "")
        score_color = ("#c0392b" if float(f["acmg_score"]) >= 6
                       else "#e67e22" if float(f["acmg_score"]) >= 0
                       else "#7f8c8d")
        mech_label = str(f["mechanism"]).replace("_FUSION", "").replace("_", " ")
        frame_label = str(f["reading_frame"]).replace("_", " ")
        top_rows.append(
            f'<tr>'
            f'<td class="gene-cell">'
            f'<span class="gene-a">{_html.escape(str(f["geneA"]))}</span>'
            f'<span class="fusion-arrow">::</span>'
            f'<span class="gene-b">{_html.escape(str(f["geneB"]))}</span></td>'
            f'<td><span class="badge-path" style="background:{pc}">'
            f'{_html.escape(str(f["pathogenicity"]).replace("_"," "))}</span></td>'
            f'<td class="score-cell" style="color:{score_color}">{f["acmg_score"]}</td>'
            f'<td><span class="frame-tag" style="color:{fc}">'
            f'{_html.escape(frame_label)}</span></td>'
