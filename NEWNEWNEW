def most_common(values):
    values = [v for v in values if str(v) not in {"", "nan", "None"}]
    if not values:
        return ""
    counts = defaultdict(int)
    for v in values:
        counts[v] += 1
    return sorted(counts.items(), key=lambda item: (-item[1], str(item[0])))[0][0]


def orientation_relation(orientation_a, orientation_b):
    if orientation_a not in {"+", "-"} or orientation_b not in {"+", "-"}:
        return "UNKNOWN"
    return f"{orientation_a}{orientation_b}"


def predict_fusion_class(gene_a, gene_b, variant_type, strand_a, strand_b, count):
    if gene_a == gene_b:
        label = "HIGH_CONF_NON_CANONICAL" if count >= 2 else "NON_CANONICAL"
        return label, "same_gene", ""
    if strand_a not in {"+", "-"} or strand_b not in {"+", "-"}:
        label = "HIGH_CONF_NON_CANONICAL" if count >= 2 else "NON_CANONICAL"
        return label, "missing_gene_strand", ""
    decision = _get_canonical_matrix().get((variant_type, strand_a, strand_b))
    if decision is None:
        label = "HIGH_CONF_NON_CANONICAL" if count >= 2 else "NON_CANONICAL"
        return label, "no_decision_matrix_match", ""
    is_canonical, promoter_bp = decision
    if is_canonical:
        label = "HIGH_CONF_CANONICAL" if count >= 2 else "CANONICAL"
        return label, "decision_matrix", str(promoter_bp)
    label = "HIGH_CONF_NON_CANONICAL" if count >= 2 else "NON_CANONICAL"
    return label, "decision_matrix", ""


